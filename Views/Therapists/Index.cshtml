@model IEnumerable<PhysioClinic.Models.Therapist>
@{
    ViewData["Title"] = "طاقم الأطباء والأخصائيين";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">طاقم الأطباء والأخصائيين 👨‍⚕️🩺</h3>
        <p class="text-muted mb-0">إدارة المعالجين والأخصائيين في العيادة، التخصصات، وألوان تمييز الجداول.</p>
    </div>
    @if (User.IsInRole(ClinicRoles.Admin))
    {
        <a asp-action="Create" class="btn btn-modern btn-modern-primary">
            <i class="bi bi-person-plus-fill me-1"></i> إضافة أخصائي جديد
        </a>
    }
</div>

<!-- Doctors Cards Grid -->
<div class="row g-4">
    @foreach (var therapist in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card-modern p-4 h-100 position-relative" style="border-top: 4px solid @therapist.ColorTag;">
                <!-- Status Badge -->
                <div class="position-absolute top-0 end-0 m-3">
                    @if (therapist.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-check-circle me-1"></i> نشط</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1"><i class="bi bi-pause-circle me-1"></i> معطل</span>
                    }
                </div>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 54px; height: 54px; font-size: 1.4rem; background-color: @therapist.ColorTag;">
                        @therapist.FullName.Substring(0, 1)
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">@therapist.FullName</h5>
                        <small class="text-muted d-block">@therapist.Title</small>
                    </div>
                </div>

                <div class="mb-3 p-2 rounded-3 bg-light">
                    <span class="small fw-semibold text-secondary d-block mb-1">
                        <i class="bi bi-award text-primary me-1"></i> التخصص الدقيق:
                    </span>
                    <span class="small fw-bold text-dark">@therapist.Specialization</span>
                </div>

                <div class="small text-muted mb-3 space-y-1">
                    @if (!string.IsNullOrEmpty(therapist.Phone))
                    {
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-telephone text-primary"></i>
                            <span dir="ltr">@therapist.Phone</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(therapist.Email))
                    {
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-envelope text-primary"></i>
                            <span dir="ltr">@therapist.Email</span>
                        </div>
                    }
                </div>

                <!-- Stats summary -->
                <div class="row g-2 text-center py-2 mb-3 border-top border-bottom">
                    <div class="col-4">
                        <div class="fw-bold text-dark fs-6">@therapist.Appointments.Count</div>
                        <small class="text-muted" style="font-size: 0.72rem;">المواعيد</small>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold text-dark fs-6">@therapist.Consultations.Count</div>
                        <small class="text-muted" style="font-size: 0.72rem;">الفحوصات</small>
                    </div>
                    <div class="col-4">
                        <div class="fw-bold text-dark fs-6">@therapist.TreatmentPlans.Count</div>
                        <small class="text-muted" style="font-size: 0.72rem;">الخطط</small>
                    </div>
                </div>

                @if (User.IsInRole(ClinicRoles.Admin))
                {
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@therapist.Id" class="btn btn-sm btn-modern btn-modern-soft">
                                <i class="bi bi-pencil-square me-1"></i> تعديل
                            </a>

                            <form asp-action="ToggleStatus" asp-route-id="@therapist.Id" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(therapist.IsActive ? "تعطيل الطبيب" : "تفعيل الطبيب")">
                                    <i class="bi @(therapist.IsActive ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                    @(therapist.IsActive ? "تعطيل" : "تفعيل")
                                </button>
                            </form>
                        </div>

                        <form asp-action="Delete" asp-route-id="@therapist.Id" method="post" class="d-inline m-0" onsubmit="return confirm('هل أنت متأكد من حذف الطبيب (@therapist.FullName)؟');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="حذف الطبيب">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>
