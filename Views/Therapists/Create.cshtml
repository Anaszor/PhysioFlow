@model PhysioClinic.Models.Therapist
@{
    ViewData["Title"] = "إضافة أخصائي جديد";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">إضافة طبيب أو أخصائي جديد 👨‍⚕️</h3>
        <p class="text-muted mb-0">تسجيل أخصائي جديد في كادر العيادة وتحديد تخصصه ولون جدوله.</p>
    </div>
    <a asp-action="Index" class="btn btn-modern btn-modern-soft">
        <i class="bi bi-arrow-right me-1"></i> العودة لقائمة الأطباء
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-modern p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="FullName" class="form-label small fw-semibold">الاسم الكامل <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-modern" placeholder="مثال: د. أحمد المحمود" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label small fw-semibold">المسمى الوظيفي <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-modern" placeholder="مثال: أخصائي علاج طبيعي وتأهيل" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Specialization" class="form-label small fw-semibold">التخصص الدقيق <span class="text-danger">*</span></label>
                        <input asp-for="Specialization" class="form-control form-control-modern" placeholder="مثال: إصابات رياضية وتأهيل عمود فقري" required />
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">رقم الهاتف</label>
                        <input asp-for="Phone" class="form-control form-control-modern dir-ltr text-end" placeholder="+96279XXXXXXX" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control form-control-modern dir-ltr text-end" placeholder="doctor@physioflow.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ColorTag" class="form-label small fw-semibold">لون التمييز في الجدول</label>
                        <div class="d-flex align-items-center gap-2">
                            <input asp-for="ColorTag" type="color" class="form-control form-control-color" style="width: 50px; height: 38px;" />
                            <small class="text-muted">اختر لوناً مميزاً لتمييز مواعيد هذا الطبيب في الجدول</small>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="chkActive" checked />
                            <label class="form-check-label small fw-semibold" for="chkActive">
                                تفعيل حساب الطبيب واستقبال الحجوزات
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-modern btn-modern-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> حفظ وإضافة الطبيب
                    </button>
                    <a asp-action="Index" class="btn btn-modern btn-modern-outline">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
