@using PhysioClinic.Models
@model PhysioClinic.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم السريرية";
}

<!-- Dashboard Executive Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0 text-dark">لوحة متابعة العيادة والتأهيل 👋</h3>
            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-bold small">
                <span class="d-inline-block rounded-circle bg-success me-1" style="width: 6px; height: 6px;"></span>
                العيادة نشطة ومتاحة
            </span>
        </div>
        <p class="text-muted mb-0">نظرة عامة وفورية على تدفق المرضى، جلسات اليوم، ومعدلات إنجاز الخطط العلاجية.</p>
    </div>

    <!-- Quick Action Launchers (Segregated by Role) -->
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
        {
            <a asp-controller="Intake" asp-action="New" class="btn btn-modern btn-modern-primary">
                <i class="bi bi-person-plus-fill me-1"></i>
                <span>تسجيل واستبيان مريض</span>
            </a>
            <a asp-controller="Appointments" asp-action="Book" class="btn btn-modern btn-modern-outline">
                <i class="bi bi-calendar2-plus me-1"></i>
                <span>حجز موعد جلسة</span>
            </a>
        }
        else if (User.IsInRole(ClinicRoles.Doctor))
        {
            <a asp-controller="Consultation" asp-action="Create" class="btn btn-modern btn-modern-primary">
                <i class="bi bi-stethoscope me-1"></i>
                <span>جلسة فحص وتشخيص</span>
            </a>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-modern btn-modern-outline">
                <i class="bi bi-calendar2-check me-1"></i>
                <span>جدول جلساتي اليوم</span>
            </a>
        }
    </div>
</div>

<!-- 4 Key Performance Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Today's Appointments -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="--metric-gradient: linear-gradient(90deg, #0d9488, #2dd4bf);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted fw-bold small">جلسات ومواعيد اليوم</span>
                <div class="metric-icon-wrap" style="background-color: #ccfbf1; color: #0f766e;">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="metric-value">@Model.TodayAppointmentsCount</div>
                <span class="metric-trend bg-success-subtle text-success">
                    <i class="bi bi-arrow-up-short"></i> 100% مجدولة
                </span>
            </div>
            <div class="text-muted small mt-2">جلسات موزعة على 3 أخصائيين</div>
        </div>
    </div>

    <!-- Active Treatment Plans -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="--metric-gradient: linear-gradient(90deg, #6366f1, #a855f7);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted fw-bold small">البرامج العلاجية النشطة</span>
                <div class="metric-icon-wrap" style="background-color: #ede9fe; color: #4338ca;">
                    <i class="bi bi-heart-pulse"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="metric-value">@Model.ActivePlansCount</div>
                <span class="metric-trend bg-primary-subtle text-primary">
                    <i class="bi bi-activity"></i> برامج جارية
                </span>
            </div>
            <div class="text-muted small mt-2">متوسط مدة الخطة: 12 جلسة</div>
        </div>
    </div>

    <!-- Completed Sessions -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="--metric-gradient: linear-gradient(90deg, #10b981, #34d399);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted fw-bold small">الجلسات المنجزة هذا الأسبوع</span>
                <div class="metric-icon-wrap" style="background-color: #dcfce7; color: #15803d;">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="metric-value">@Model.CompletedSessionsThisWeek</div>
                <span class="metric-trend bg-success-subtle text-success">
                    <i class="bi bi-check2-all"></i> نجاح مكتمل
                </span>
            </div>
            <div class="text-muted small mt-2">تخفيف آلام المراجعين بنسبة 85%</div>
        </div>
    </div>

    <!-- Total Clients -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="--metric-gradient: linear-gradient(90deg, #f59e0b, #fbbf24);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted fw-bold small">إجمالي قاعدة المرضى</span>
                <div class="metric-icon-wrap" style="background-color: #fef3c7; color: #b45309;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
                <div class="metric-value">@Model.TotalClientsCount</div>
                <span class="metric-trend bg-warning-subtle text-warning">
                    <i class="bi bi-person-check"></i> ملفات مفعلة
                </span>
            </div>
            <div class="text-muted small mt-2">سجلات إلكترونية كاملة (EHR)</div>
        </div>
    </div>
</div>

<!-- Main Row: Today's Appointments & Active Plans Progress -->
<div class="row g-4 mb-4">
    <!-- Today's Schedule Table -->
    <div class="col-xl-8">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="zone-avatar" style="width: 36px; height: 36px; background-color: var(--primary-light); color: var(--primary-dark); font-size: 1.1rem;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">جدول جلسات اليوم (@DateTime.Today.ToString("dd MMMM yyyy"))</h6>
                        <small class="text-muted">متابعة حضور المرضى وتحديث حالة الجلسة</small>
                    </div>
                </div>

                <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-modern-soft">
                    عرض التقويم &larr;
                </a>
            </div>

            <div class="p-0">
                @if (!Model.TodayAppointments.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                        <h6 class="text-muted mt-2 fw-bold">لا توجد جلسات مجدولة لهذا اليوم حتى الآن</h6>
                        <a asp-controller="Appointments" asp-action="Book" class="btn btn-sm btn-modern-primary mt-2">حجز أول جلسة</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>التوقيت</th>
                                    <th>المريض</th>
                                    <th>الأخصائي</th>
                                    <th>نوع الجلسة</th>
                                    <th>الحالة</th>
                                    <th class="text-start">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.TodayAppointments)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark font-monospace" dir="ltr">@appt.StartTime - @appt.EndTime</div>
                                            <span class="text-muted small">60 دقيقة (ساعة)</span>
                                            @if ((User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin)) && appt.Status != "Completed")
                                            {
                                                <a asp-controller="Appointments" asp-action="Index" asp-route-date="@appt.AppointmentDate.ToString("yyyy-MM-dd")" class="d-block btn btn-sm btn-modern-primary py-0 px-2 mt-1 shadow-sm" style="font-size: 0.72rem;">
                                                    <i class="bi bi-clipboard2-pulse me-1"></i> توثيق الجلسة
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@appt.ClientId" class="text-decoration-none fw-bold text-dark">
                                                @appt.Client?.FullName
                                            </a>
                                            <div class="small text-muted" dir="ltr" style="text-align: right;"><span class="me-1">@appt.Client?.Phone</span><i class="bi bi-telephone text-muted"></i></div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill" style="background-color: @(appt.Therapist?.ColorTag ?? "#0d9488")15; color: @(appt.Therapist?.ColorTag ?? "#0d9488"); border: 1px solid @(appt.Therapist?.ColorTag ?? "#0d9488")30; font-weight: 600;">
                                                <i class="bi bi-person-fill me-1"></i> @appt.Therapist?.FullName
                                            </span>
                                        </td>
                                        <td>
                                            @if (appt.SessionNumber.HasValue)
                                            {
                                                <span class="badge bg-light text-secondary border fw-bold">الجلسة #@appt.SessionNumber</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle fw-bold">استشارة وفحص أول</span>
                                            }
                                        </td>
                                        <td>
                                            @if (appt.Status == "Confirmed")
                                            {
                                                <span class="badge-status badge-status-confirmed">مؤكد الحضور</span>
                                            }
                                            else if (appt.Status == "Scheduled")
                                            {
                                                <span class="badge-status badge-status-scheduled">مجدول</span>
                                            }
                                            else if (appt.Status == "Completed")
                                            {
                                                <span class="badge-status badge-status-completed">اكتملت الجلسة</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-cancelled">@appt.Status</span>
                                            }
                                        </td>
                                        <td class="text-start">
                                            <div class="d-flex align-items-center justify-content-end gap-1">
                                                @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                                                {
                                                    @if (appt.Status != "Completed")
                                                    {
                                                        <a asp-controller="Appointments" asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-success py-1 px-2" title="توثيق الجلسة">
                                                            <i class="bi bi-clipboard2-pulse me-1"></i> توثيق
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success py-1 px-2 small">موثقة</span>
                                                    }
                                                }

                                                @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                                                {
                                                    @if (appt.Status == "Scheduled")
                                                    {
                                                        <form asp-controller="Appointments" asp-action="ConfirmAttendance" method="post" class="d-inline m-0">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@appt.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-primary py-1 px-2" title="تأكيد الحضور">
                                                                <i class="bi bi-person-check me-1"></i> وصل
                                                            </button>
                                                        </form>
                                                    }
                                                }

                                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@appt.ClientId" class="btn btn-sm btn-light border py-1 px-2" title="الملف الطبي">
                                                    <i class="bi bi-folder2-open"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Active Treatment Plans Progress -->
    <div class="col-xl-4">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="zone-avatar" style="width: 36px; height: 36px; background-color: #ede9fe; color: #4338ca; font-size: 1.1rem;">
                        <i class="bi bi-trophy"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">متابعة برامج التأهيل</h6>
                        <small class="text-muted">نسبة إنجاز الخطط الحالية</small>
                    </div>
                </div>

                <a asp-controller="TreatmentPlan" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-bold" style="color: var(--primary);">
                    الكل &larr;
                </a>
            </div>

            <div class="card-modern-body">
                @if (!Model.ActivePlans.Any())
                {
                    <p class="text-muted text-center py-4">لا توجد برامج علاجية نشطة حالياً.</p>
                }
                else
                {
                    @foreach (var plan in Model.ActivePlans)
                    {
                        <div class="p-3 mb-3 border rounded-3 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <a asp-controller="TreatmentPlan" asp-action="Details" asp-route-id="@plan.Id" class="text-decoration-none text-dark">
                                        @plan.Title
                                    </a>
                                </h6>
                                <span class="badge bg-teal-subtle text-teal fw-bold" style="background-color: var(--primary-light); color: var(--primary-darker);">
                                    @plan.ProgressPercentage%
                                </span>
                            </div>
                            <div class="small text-muted mb-2">المريض: <strong>@plan.Client?.FullName</strong></div>
                            
                            <!-- Sleek Modern Progress Bar -->
                            <div class="progress" style="height: 8px; border-radius: 9999px; background-color: var(--slate-200);">
                                <div class="progress-bar" role="progressbar" style="width: @plan.ProgressPercentage%; background: var(--primary-gradient);" aria-valuenow="@plan.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center small text-muted mt-2">
                                <span><i class="bi bi-check2 text-teal" style="color: var(--primary);"></i> إنجاز @plan.CompletedSessions من أصل @plan.TotalSessions جلسة</span>
                                <span>@plan.Frequency</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Specialists Team Grid -->
<div class="card-modern">
    <div class="card-modern-header">
        <div class="d-flex align-items-center gap-2">
            <div class="zone-avatar" style="width: 36px; height: 36px; background-color: #ecfdf5; color: #059669; font-size: 1.1rem;">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-0 text-dark">فريق الأخصائيين المعالجين وجاهزية المواعيد</h6>
                <small class="text-muted">طاقم التأهيل الطبي المعتمد بالمركز</small>
            </div>
        </div>
    </div>

    <div class="card-modern-body">
        <div class="row g-3">
            @foreach (var th in Model.Therapists)
            {
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 d-flex align-items-center gap-3 bg-white" style="border-right: 4px solid @th.ColorTag !important;">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 48px; height: 48px; background-color: @th.ColorTag; font-size: 1.25rem;">
                            @th.FullName.Substring(0, 1)
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="fw-bold mb-0 text-truncate">@th.FullName</h6>
                            <small class="text-muted d-block text-truncate">@th.Title</small>
                            <span class="badge bg-light text-secondary border mt-1">@th.Specialization</span>
                        </div>
                        <a asp-controller="Appointments" asp-action="Book" asp-route-therapistId="@th.Id" class="btn btn-sm btn-modern-soft" title="حجز جلسة">
                            <i class="bi bi-calendar-plus"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
