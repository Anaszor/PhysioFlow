@model PhysioClinic.Models.Client
@{
    ViewData["Title"] = "تعديل بيانات المريض - " + Model.FullName;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">تعديل بيانات المريض ✏️</h3>
        <p class="text-muted mb-0">تحديث المعلومات الشخصية والاتصال الخاصة بـ @Model.FullName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-modern btn-modern-soft">
            <i class="bi bi-arrow-right me-1"></i> العودة للملف الطبي
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label small fw-semibold">الاسم الكامل <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-modern" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label small fw-semibold">رقم الهاتف <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control form-control-modern dir-ltr text-end" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label small fw-semibold">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control form-control-modern dir-ltr text-end" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label small fw-semibold">الجنس</label>
                        <select asp-for="Gender" class="form-select form-control-modern">
                            <option value="Male">ذكر</option>
                            <option value="Female">أنثى</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label small fw-semibold">تاريخ الميلاد</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control form-control-modern" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NationalId" class="form-label small fw-semibold">الرقم الوطني / الإقامة</label>
                        <input asp-for="NationalId" class="form-control form-control-modern dir-ltr" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Occupation" class="form-label small fw-semibold">المهنة / طبيعة العمل</label>
                        <input asp-for="Occupation" class="form-control form-control-modern" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmergencyContact" class="form-label small fw-semibold">رقم الطوارئ أو قريب</label>
                        <input asp-for="EmergencyContact" class="form-control form-control-modern dir-ltr text-end" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label small fw-semibold">ملاحظات عامة</label>
                        <textarea asp-for="Notes" rows="3" class="form-control form-control-modern" placeholder="أي ملاحظات خاصة بالمريض..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-modern btn-modern-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> حفظ التعديلات
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-modern btn-modern-outline">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
