@model PhysioClinic.Models.Client
@{
    ViewData["Title"] = "تسجيل ملف مريض جديد";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="clinic-card">
            <div class="clinic-card-header">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-plus text-teal me-2" style="color: #0d9488;"></i> تسجيل ملف مريض جديد</h5>
            </div>
            <div class="p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-bold">الاسم الكامل <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="الاسم ثلاثي أو رباعي" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold">رقم الجوال <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+966 5x xxx xxxx" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Gender" class="form-label fw-bold">الجنس</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Male">ذكر</option>
                                <option value="Female">أنثى</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="DateOfBirth" class="form-label fw-bold">تاريخ الميلاد</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Occupation" class="form-label fw-bold">المهنة / طبيعة النشاط</label>
                            <input asp-for="Occupation" class="form-control" placeholder="مثال: مهندس، معلم، رياضي..." />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmergencyContact" class="form-label fw-bold">جهة اتصال الطوارئ</label>
                            <input asp-for="EmergencyContact" class="form-control" placeholder="الاسم ورقم الهاتف والقرابة" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-bold">ملاحظات عامة</label>
                            <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                        <button type="submit" class="btn btn-clinic-primary px-4">حفظ الملف &larr;</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
