@using PhysioClinic.Models
@model PhysioClinic.Models.Client
@{
    ViewData["Title"] = $"الملف الطبي - {Model.FullName}";
}

<!-- Patient Master Profile Header -->
<div class="card-modern mb-4 p-4" style="background: linear-gradient(135deg, #0f766e 0%, #115e59 100%); color: #ffffff;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-4 bg-white bg-opacity-20 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 72px; height: 72px; font-size: 2rem;">
                @Model.FullName.Substring(0, 1)
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold mb-0 text-white">@Model.FullName</h3>
                    <span class="badge bg-white text-dark fw-bold rounded-pill px-3">
                        @(Model.Gender == "Male" ? "ذكر" : "أنثى") &bull; @Model.Age سنة
                    </span>
                </div>
                <div class="text-white-50 d-flex flex-wrap gap-3 small mt-1">
                    <span dir="ltr"><i class="bi bi-telephone-fill ms-1"></i> @Model.Phone</span>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <span><i class="bi bi-envelope-fill me-1"></i> @Model.Email</span>
                    }
                    <span><i class="bi bi-briefcase-fill me-1"></i> @(Model.Occupation ?? "غير محدد")</span>
                    <span><i class="bi bi-calendar-event me-1"></i> مسجل منذ: @Model.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>

        <!-- Quick Action Toolbar (Role Segregated) -->
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
            {
                <a asp-controller="Appointments" asp-action="Book" asp-route-clientId="@Model.Id" class="btn btn-warning text-dark fw-bold rounded-pill px-3">
                    <i class="bi bi-calendar-plus me-1"></i> حجز جلسة
                </a>
                <a asp-controller="Intake" asp-action="New" asp-route-clientId="@Model.Id" class="btn btn-outline-light rounded-pill px-3">
                    <i class="bi bi-clipboard-plus me-1"></i> تقييم إصابة جديدة
                </a>
            }

            @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
            {
                <a asp-controller="Consultation" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-light text-dark fw-bold rounded-pill px-3">
                    <i class="bi bi-stethoscope me-1"></i> فحص واستشارة
                </a>
                <a asp-controller="TreatmentPlan" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-outline-light rounded-pill px-3">
                    <i class="bi bi-heart-pulse me-1"></i> إنشاء خطة علاج
                </a>
            }
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="segmented-tabs mb-4" id="clientTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="plans-tab" data-bs-toggle="tab" data-bs-target="#plans" type="button" role="tab">
            <i class="bi bi-heart-pulse-fill me-1"></i> الخطط العلاجية والتأهيل (@Model.TreatmentPlans.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="intake-tab" data-bs-toggle="tab" data-bs-target="#intake" type="button" role="tab">
            <i class="bi bi-clipboard2-pulse me-1"></i> استبيانات الإصابة والألم (@Model.IntakeForms.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="consult-tab" data-bs-toggle="tab" data-bs-target="#consult" type="button" role="tab">
            <i class="bi bi-journal-medical me-1"></i> الاستشارات السريرية (@Model.Consultations.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="appts-tab" data-bs-toggle="tab" data-bs-target="#appts" type="button" role="tab">
            <i class="bi bi-calendar-check me-1"></i> سجل المواعيد والجلسات (@Model.Appointments.Count)
        </button>
    </li>
</ul>

<!-- Tab Contents -->
<div class="tab-content" id="clientTabsContent">
    <!-- 1. Treatment Plans Tab -->
    <div class="tab-pane fade show active" id="plans" role="tabpanel">
        @if (!Model.TreatmentPlans.Any())
        {
            <div class="card-modern p-5 text-center">
                <i class="bi bi-heart-pulse text-muted" style="font-size: 3rem;"></i>
                <h6 class="text-muted mt-2 fw-bold">لا توجد خطة علاجية مخصصة لهذا المريض بعد</h6>
                @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-controller="TreatmentPlan" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-modern btn-modern-primary mt-3">
                        + إنشاء أول خطة علاجية
                    </a>
                }
                else
                {
                    <p class="text-muted small mt-2">يتم إنشاء الخطة العلاجية من قِبل الطبيب المعالج بعد جلسة الفحص.</p>
                }
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var plan in Model.TreatmentPlans)
                {
                    <div class="col-lg-6">
                        <div class="card-modern h-100 p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    @if (plan.Status == "Active")
                                    {
                                        <span class="badge-status badge-status-confirmed mb-1">جاري التنفيذ</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-completed mb-1">مكتمل</span>
                                    }
                                    <h5 class="fw-bold mb-1">
                                        <a asp-controller="TreatmentPlan" asp-action="Details" asp-route-id="@plan.Id" class="text-decoration-none text-dark">
                                            @plan.Title
                                        </a>
                                    </h5>
                                </div>
                                <span class="badge bg-teal-subtle text-teal fs-6 fw-bold px-3 py-1 rounded-pill" style="background-color: var(--primary-light); color: var(--primary-darker);">
                                    @plan.ProgressPercentage%
                                </span>
                            </div>

                            <div class="small text-muted mb-3">الأخصائي المشرف: <strong class="text-dark">@plan.Therapist?.FullName</strong> &bull; @plan.Frequency</div>

                            <!-- Progress Bar -->
                            <div class="progress mb-2" style="height: 10px; border-radius: 9999px;">
                                <div class="progress-bar" role="progressbar" style="width: @plan.ProgressPercentage%; background: var(--primary-gradient);"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small mb-3">
                                <span>تم إنجاز @plan.CompletedSessions من @plan.TotalSessions جلسة</span>
                                <span>@(plan.TotalSessions - plan.CompletedSessions) جلسة متبقية</span>
                            </div>

                            <!-- Modalities -->
                            <div class="mb-3">
                                <span class="small fw-bold text-secondary d-block mb-1">الأساليب المعتمدة:</span>
                                <div>
                                    @foreach (var mod in (plan.Modalities ?? "").Split('،', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1 p-2">@mod.Trim()</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(plan.MedicationAndHomeCare))
                            {
                                <div class="p-3 bg-light rounded-3 small mb-3">
                                    <strong class="text-danger"><i class="bi bi-capsule me-1"></i> الأدوية والكمادات:</strong>
                                    <div>@plan.MedicationAndHomeCare</div>
                                </div>
                            }

                            <div class="d-flex gap-2">
                                <a asp-controller="TreatmentPlan" asp-action="Details" asp-route-id="@plan.Id" class="btn btn-sm btn-modern btn-modern-primary">
                                    متابعة تفاصيل الخطة &larr;
                                </a>
                                <a asp-controller="Appointments" asp-action="Book" asp-route-clientId="@Model.Id" asp-route-therapistId="@plan.TherapistId" class="btn btn-sm btn-modern btn-modern-outline">
                                    حجز الجلسة القادمة
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 2. Intake Forms Tab -->
    <div class="tab-pane fade" id="intake" role="tabpanel">
        @if (!Model.IntakeForms.Any())
        {
            <div class="card-modern p-5 text-center">
                <i class="bi bi-clipboard2-x text-muted" style="font-size: 3rem;"></i>
                <h6 class="text-muted mt-2 fw-bold">لا توجد استبيانات إصابة مسجلة لهذا المريض</h6>
                <a asp-controller="Intake" asp-action="New" asp-route-clientId="@Model.Id" class="btn btn-modern btn-modern-primary mt-3">
                    + تعبئة استبيان إصابة جديد
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var intake in Model.IntakeForms)
                {
                    <div class="col-lg-6">
                        <div class="card-modern p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-light text-dark border fs-6 px-3 py-2 rounded-pill">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @intake.BodyPart
                                </span>
                                <span class="badge px-3 py-2 fw-bold rounded-pill" style="background-color: @(intake.PainLevel >= 7 ? "#fee2e2" : (intake.PainLevel >= 4 ? "#fef3c7" : "#dcfce7")); color: @(intake.PainLevel >= 7 ? "#b91c1c" : (intake.PainLevel >= 4 ? "#b45309" : "#15803d"));">
                                    مقياس الألم: @intake.PainLevel / 10
                                </span>
                            </div>

                            <h5 class="fw-bold mb-2">@intake.InjuryType</h5>
                            <p class="text-muted small mb-3">سبب الإصابة: @(intake.InjuryCause ?? "غير محدد") &bull; تاريخ البداية: @intake.OnsetDate.ToString("yyyy-MM-dd")</p>

                            <div class="mb-3">
                                <label class="small text-muted fw-bold d-block">طبيعة الألم وصفته:</label>
                                <div class="p-2 bg-light border rounded small">@(intake.PainDescription ?? "لا يوجد وصف مسجل")</div>
                            </div>

                            <div class="mb-3">
                                <label class="small text-muted fw-bold d-block">الأعراض المصاحبة:</label>
                                <span class="text-secondary small">@(intake.Symptoms ?? "لا توجد أعراض إضافية")</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center border-top pt-3 small text-muted">
                                <span>تقارير إشعاعية: @(intake.HasRadiologyReports ? "نعم متوفرة" : "لا تتوفر")</span>
                                <span>سُجل بتاريخ: @intake.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 3. Consultations Tab -->
    <div class="tab-pane fade" id="consult" role="tabpanel">
        @if (!Model.Consultations.Any())
        {
            <div class="card-modern p-5 text-center">
                <i class="bi bi-stethoscope text-muted" style="font-size: 3rem;"></i>
                <h6 class="text-muted mt-2 fw-bold">لا توجد جلسات استشارة مسجلة</h6>
                @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-controller="Consultation" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-modern btn-modern-primary mt-3">
                        + تسجيل استشارة وفحص سريري
                    </a>
                }
                else
                {
                    <p class="text-muted small mt-2">تسجيل الفحص والتشخيص السريري متاح فقط للأطباء المعالجين.</p>
                }
            </div>
        }
        else
        {
            @foreach (var c in Model.Consultations)
            {
                <div class="card-modern mb-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-0 text-teal" style="color: var(--primary);"><i class="bi bi-file-earmark-medical me-2"></i> @c.Diagnosis</h5>
                            <small class="text-muted">الأخصائي المشرف: @c.Therapist?.FullName &bull; تاريخ الاستشارة: @c.ConsultationDate.ToString("yyyy-MM-dd")</small>
                        </div>
                        @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                        {
                            <a asp-controller="TreatmentPlan" asp-action="Create" asp-route-clientId="@Model.Id" asp-route-consultationId="@c.Id" class="btn btn-sm btn-modern btn-modern-soft">
                                + تحويل إلى خطة علاجية
                            </a>
                        }
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <label class="fw-bold small text-secondary d-block mb-1">الشكوى الرئيسية:</label>
                                <p class="mb-0 small">@c.ChiefComplaint</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <label class="fw-bold small text-secondary d-block mb-1">فحص المدى الحركي (ROM):</label>
                                <p class="mb-0 small">@(c.RangeOfMotionFindings ?? "طبيعي")</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(c.TreatmentGoals))
                        {
                            <div class="col-12">
                                <label class="fw-bold small text-secondary d-block mb-1">أهداف العلاج الموضوعة:</label>
                                <div class="p-3 bg-light border rounded-3 small" style="white-space: pre-line;">@c.TreatmentGoals</div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- 4. Appointments Tab -->
    <div class="tab-pane fade" id="appts" role="tabpanel">
        <div class="card-modern">
            <div class="card-modern-header">
                <h6 class="fw-bold mb-0">سجل مواعيد المراجع</h6>
                <a asp-controller="Appointments" asp-action="Book" asp-route-clientId="@Model.Id" class="btn btn-sm btn-modern btn-modern-primary">
                    + حجز موعد جديد
                </a>
            </div>
            <div class="p-0">
                @if (!Model.Appointments.Any())
                {
                    <p class="text-muted text-center py-4">لم يتم حجز أي مواعيد لهذا المريض بعد.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-modern">
                            <thead>
                                <tr>
                                    <th>التاريخ</th>
                                    <th>الوقت</th>
                                    <th>الأخصائي</th>
                                    <th>الجلسة</th>
                                    <th>الحالة</th>
                                    <th>الملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.Appointments)
                                {
                                    <tr>
                                        <td class="fw-bold">@appt.AppointmentDate.ToString("yyyy-MM-dd")</td>
                                        <td class="font-monospace">@appt.StartTime - @appt.EndTime</td>
                                        <td>@appt.Therapist?.FullName</td>
                                        <td>
                                            @if (appt.SessionNumber.HasValue)
                                            {
                                                <span class="badge bg-light text-secondary border">الجلسة #@appt.SessionNumber</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info">استشارة</span>
                                            }
                                        </td>
                                        <td>
                                            @if (appt.Status == "Confirmed")
                                            {
                                                <span class="badge-status badge-status-confirmed">مؤكد</span>
                                            }
                                            else if (appt.Status == "Completed")
                                            {
                                                <span class="badge-status badge-status-completed">مكتمل</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-scheduled">@appt.Status</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@(appt.SessionNotes ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
