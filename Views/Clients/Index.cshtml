@model IEnumerable<PhysioClinic.Models.Client>
@{
    ViewData["Title"] = "سجلات وملفات المرضى";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">سجلات وملفات المرضى 👥</h3>
        <p class="text-muted mb-0">قاعدة بيانات المراجعين، التاريخ المرضي، والملف الطبي الشامل لكل مريض.</p>
    </div>
    <a asp-controller="Intake" asp-action="New" class="btn btn-modern btn-modern-primary">
        <i class="bi bi-person-plus-fill"></i>
        <span>تسجيل واستبيان مريض جديد</span>
    </a>
</div>

<!-- Search Bar -->
<div class="card-modern mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control form-control-modern border-start-0" placeholder="ابحث بالاسم، رقم الهاتف، أو رقم الهوية..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-modern btn-modern-primary w-100">بحث</button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
            {
                <a asp-action="Index" class="btn btn-modern btn-modern-outline">إلغاء</a>
            }
        </div>
    </form>
</div>

<!-- Clients Table Card -->
<div class="card-modern">
    <div class="p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="zone-avatar mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--slate-100); color: var(--slate-400); font-size: 2rem;">
                    <i class="bi bi-people"></i>
                </div>
                <h5 class="fw-bold text-dark mt-2">لم يتم العثور على أي ملفات تطابق البحث</h5>
                <a asp-controller="Intake" asp-action="New" class="btn btn-modern btn-modern-primary mt-2">تسجيل مريض جديد</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>المريض</th>
                            <th>العمر / الجنس</th>
                            <th>المهنة</th>
                            <th>آخر إصابة مسجلة</th>
                            <th>الخطط النشطة</th>
                            <th>إجمالي الزيارات</th>
                            <th class="text-start">الملف الطبي</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            var latestIntake = client.IntakeForms.OrderByDescending(i => i.CreatedAt).FirstOrDefault();
                            var activePlans = client.TreatmentPlans.Count(p => p.Status == "Active");

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="therapist-avatar" style="background: var(--primary-gradient);">
                                            @client.FullName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@client.Id" class="text-decoration-none fw-bold text-dark fs-6">
                                                @client.FullName
                                            </a>
                                            <div class="small text-muted" dir="ltr" style="text-align: right;"><span class="me-1">@client.Phone</span><i class="bi bi-telephone text-muted"></i></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold">@client.Age سنة</span>
                                    <small class="text-muted d-block">@(client.Gender == "Male" ? "ذكر" : "أنثى")</small>
                                </td>
                                <td class="small text-secondary">
                                    @(client.Occupation ?? "غير محدد")
                                </td>
                                <td>
                                    @if (latestIntake != null)
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-geo-alt text-danger me-1"></i> @latestIntake.BodyPart
                                        </span>
                                        <div class="small text-muted text-truncate" style="max-width: 180px;">@latestIntake.InjuryType</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">لا يوجد استبيان</span>
                                    }
                                </td>
                                <td>
                                    @if (activePlans > 0)
                                    {
                                        <span class="badge-status badge-status-confirmed">@activePlans خطة نشطة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">لا يوجد</span>
                                    }
                                </td>
                                <td class="fw-bold font-monospace">
                                    @client.Appointments.Count() جلسة
                                </td>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-1 justify-content-end">
                                        <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-modern btn-modern-soft" title="عرض الملف الطبي الشامل">
                                            <i class="bi bi-folder2-open me-1"></i> الملف
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary" title="تعديل بيانات المريض">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        @if (User.IsInRole(ClinicRoles.Admin))
                                        {
                                            <form asp-action="Delete" asp-route-id="@client.Id" method="post" class="d-inline m-0" onsubmit="return confirm('تحذير: هل أنت متأكد من حذف ملف المريض (@client.FullName)؟ سيتم حذف جميع مواعيده وسجلاته المرتبطة!');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="حذف ملف المريض">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
