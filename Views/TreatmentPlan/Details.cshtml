@using PhysioClinic.Models
@model PhysioClinic.Models.TreatmentPlan
@{
    ViewData["Title"] = Model.Title;
}

<!-- Plan Overview Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-2">
            @if (Model.Status == "Active")
            {
                <span class="badge-status badge-status-confirmed">برنامج نشط</span>
            }
            else
            {
                <span class="badge-status badge-status-completed">برنامج مكتمل</span>
            }
            <span class="text-muted small">&bull; بدأ في: @Model.StartDate.ToString("yyyy-MM-dd")</span>
        </div>
        <h3 class="fw-bold mb-1 text-dark">@Model.Title</h3>
        <p class="text-muted mb-0">
            المريض: <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="fw-bold text-dark text-decoration-none">@Model.Client?.FullName</a>
            &bull; الأخصائي: <span class="fw-bold" style="color: @(Model.Therapist?.ColorTag ?? "var(--primary)");">@Model.Therapist?.FullName</span>
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
        {
            <a asp-controller="Appointments" asp-action="Book" asp-route-clientId="@Model.ClientId" asp-route-therapistId="@Model.TherapistId" class="btn btn-modern btn-modern-primary">
                <i class="bi bi-calendar-plus me-1"></i> حجز جلسة قادمة
            </a>
        }
        <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-modern btn-modern-outline">
            <i class="bi bi-person me-1"></i> ملف المريض
        </a>
    </div>
</div>

<!-- Sessions Visual Tracker Bar -->
<div class="card-modern mb-4 p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-bullseye text-teal me-2" style="color: var(--primary);"></i> مسار إنجاز الجلسات المقررة</h6>
            <div class="text-muted small">تم إنجاز <strong>@Model.CompletedSessions</strong> جلسة من أصل <strong>@Model.TotalSessions</strong> جلسة (@Model.ProgressPercentage%)</div>
        </div>
        @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
        {
            @if (Model.Status == "Active" && Model.CompletedSessions < Model.TotalSessions)
            {
                <form asp-action="IncrementSession" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-modern btn-modern-primary shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> تسجيل إتمام الجلسة رقم @(Model.CompletedSessions + 1)
                    </button>
                </form>
            }
        }
        else
        {
            <span class="badge bg-light text-muted border">تسجيل إتمام الجلسات خاص بالطبيب المعالج</span>
        }
    </div>

    <!-- Progress Bar -->
    <div class="progress mb-4" style="height: 10px; border-radius: 9999px;">
        <div class="progress-bar" role="progressbar" style="width: @Model.ProgressPercentage%; background: var(--primary-gradient);"></div>
    </div>

    <!-- Interactive Session Dots -->
    <div class="d-flex flex-wrap gap-2 justify-content-start">
        @for (int i = 1; i <= Model.TotalSessions; i++)
        {
            bool isCompleted = i <= Model.CompletedSessions;
            bool isNext = i == Model.CompletedSessions + 1;

            <div class="d-flex flex-column align-items-center justify-content-center p-2 rounded-3 border text-center" 
                 style="width: 58px; height: 64px; background-color: @(isCompleted ? "var(--primary-light)" : (isNext ? "var(--warning-light)" : "#ffffff")); border-color: @(isCompleted ? "var(--primary)" : (isNext ? "var(--warning)" : "var(--slate-200)")) !important;">
                <span class="small fw-bold @(isCompleted ? "text-teal" : (isNext ? "text-warning" : "text-muted"))" style="color: @(isCompleted ? "var(--primary-dark)" : "")">#@i</span>
                @if (isCompleted)
                {
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                }
                else if (isNext)
                {
                    <i class="bi bi-hourglass-split text-warning fs-5"></i>
                }
                else
                {
                    <i class="bi bi-circle text-muted fs-5"></i>
                }
            </div>
        }
    </div>
</div>

<!-- Plan Details Grid -->
<div class="row g-4 mb-4">
    <!-- Modalities & Care -->
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-magic text-teal me-2" style="color: var(--primary);"></i> الأساليب العلاجية المعتمدة</h6>
            </div>
            <div class="card-modern-body">
                <div class="mb-4">
                    <label class="text-muted small d-block mb-2">الوسائل المستخدمة في الجلسات:</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var mod in (Model.Modalities ?? "").Split('،', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-light text-dark border p-2 px-3 fs-6 rounded-pill"><i class="bi bi-check2 text-teal me-1" style="color: var(--primary);"></i> @mod.Trim()</span>
                        }
                    </div>
                </div>

                <div class="border-top pt-3">
                    <label class="text-muted small d-block mb-1">توجيهات الأدوية والكمادات والمكملات:</label>
                    <div class="p-3 bg-light rounded-3">
                        <i class="bi bi-capsule text-danger me-2"></i>
                        @(string.IsNullOrWhiteSpace(Model.MedicationAndHomeCare) ? "لا توجد توجيهات خاصة مسجلة." : Model.MedicationAndHomeCare)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Home Exercises -->
    <div class="col-lg-6">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-house-heart text-success me-2"></i> التمارين المنزلية الموصوفة للمريض</h6>
            </div>
            <div class="card-modern-body">
                <div class="p-3 bg-light border rounded-3" style="white-space: pre-line; line-height: 1.8;">
                    @if (string.IsNullOrWhiteSpace(Model.HomeExercises))
                    {
                        <span class="text-muted">لم يتم إدراج تمارين منزلية محددة حتى الآن.</span>
                    }
                    else
                    {
                        @Model.HomeExercises
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Linked Appointments -->
<div class="card-modern mb-5">
    <div class="card-modern-header d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-primary me-2"></i> مواعيد وجلسات هذه الخطة</h6>
        <a asp-controller="Appointments" asp-action="Book" asp-route-clientId="@Model.ClientId" asp-route-therapistId="@Model.TherapistId" class="btn btn-sm btn-modern btn-modern-primary">
            + حجز جلسة جديدة
        </a>
    </div>
    <div class="p-0">
        @if (!Model.Appointments.Any())
        {
            <p class="text-muted text-center py-4">لم يتم جدولة مواعيد خاصة بهذه الخطة بعد.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>تاريخ الجلسة</th>
                            <th>الوقت</th>
                            <th>الأخصائي</th>
                            <th>رقم الجلسة</th>
                            <th>الحالة</th>
                            <th>الملاحظات السريرية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td class="fw-bold">@appt.AppointmentDate.ToString("yyyy-MM-dd")</td>
                                <td class="font-monospace">@appt.StartTime - @appt.EndTime</td>
                                <td>@appt.Therapist?.FullName</td>
                                <td>
                                    @if (appt.SessionNumber.HasValue)
                                    {
                                        <span class="badge bg-light text-secondary border">الجلسة #@appt.SessionNumber</span>
                                    }
                                </td>
                                <td>
                                    @if (appt.Status == "Completed")
                                    {
                                        <span class="badge-status badge-status-completed">مكتمل</span>
                                    }
                                    else if (appt.Status == "Confirmed")
                                    {
                                        <span class="badge-status badge-status-confirmed">مؤكد</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-scheduled">@appt.Status</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(appt.SessionNotes ?? "-")
                                    @if (appt.Status == "Completed")
                                    {
                                        <a asp-controller="Appointments" asp-action="SessionReport" asp-route-id="@appt.Id" target="_blank" class="badge bg-light text-danger border ms-2 text-decoration-none" title="طباعة أو تحميل تقرير الجلسة">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> تقرير PDF
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
