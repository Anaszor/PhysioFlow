@using Microsoft.AspNetCore.Identity
@using PhysioClinic.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ApplicationUser? currentUser = null;
    string currentRole = "طاقم العيادة";
    string roleBadgeStyle = "background-color: var(--primary-light); color: var(--primary-darker);";
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (User.IsInRole(ClinicRoles.Admin))
        {
            currentRole = "مدير النظام (Admin)";
            roleBadgeStyle = "background-color: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe;";
        }
        else if (User.IsInRole(ClinicRoles.Doctor))
        {
            currentRole = "أخصائي معالج (Doctor)";
            roleBadgeStyle = "background-color: #ccfbf1; color: #0f766e; border: 1px solid #99f6e4;";
        }
        else if (User.IsInRole(ClinicRoles.Receptionist))
        {
            currentRole = "استقبال (Receptionist)";
            roleBadgeStyle = "background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;";
        }
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - فيزيو فلو | PhysioFlow Clinic</title>

    <!-- Google Fonts (Arabic & Latin) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 RTL CSS (Local + CDN Fallback) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />

    <!-- Bootstrap Icons (Local + CDN Fallback) -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- PhysioFlow Modern Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Overlay for Mobile/Tablet -->
        <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <!-- Brand Logo -->
            <div class="sidebar-header">
                <div class="brand-icon-box">
                    <i class="bi bi-activity"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark tracking-tight">Physio<span style="color: var(--primary);">Flow</span></h5>
                    <span class="text-muted" style="font-size: 0.72rem; font-weight: 600;">نظام العلاج الطبيعي والتأهيل</span>
                </div>
                <button class="btn btn-sm btn-light border-0 d-xl-none ms-auto me-0" onclick="toggleSidebar()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-nav">
                <div class="nav-category">العيادة وسير العمل</div>
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>لوحة التحكم والمتابعة</span>
                </a>

                @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-controller="Intake" asp-action="New" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Intake" ? "active" : "")">
                        <i class="bi bi-clipboard2-pulse-fill"></i>
                        <span>تسجيل واستبيان مريض جديد</span>
                    </a>
                }

                <a asp-controller="Appointments" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-calendar-week-fill"></i>
                    <span>@(User.IsInRole(ClinicRoles.Doctor) ? "جدول جلساتي اليومية" : "جدول المواعيد والعيادات")</span>
                </a>

                @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-controller="Appointments" asp-action="Book" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" && ViewContext.RouteData.Values["action"]?.ToString() == "Book" ? "active" : "")">
                        <i class="bi bi-calendar-plus-fill"></i>
                        <span>حجز فترات الجلسات (Slots)</span>
                    </a>
                }

                <div class="nav-category mt-3">الملفات الطبية والتأهيل</div>
                <a asp-controller="Clients" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    <span>سجلات وملفات المرضى</span>
                </a>
                <a asp-controller="Therapists" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Therapists" ? "active" : "")">
                    <i class="bi bi-person-badge-fill"></i>
                    <span>طاقم الأطباء والأخصائيين</span>
                </a>

                @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-controller="Consultation" asp-action="Create" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consultation" ? "active" : "")">
                        <i class="bi bi-stethoscope"></i>
                        <span>فحص وتشخيص سريري</span>
                    </a>
                    <a asp-controller="TreatmentPlan" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TreatmentPlan" ? "active" : "")">
                        <i class="bi bi-heart-pulse-fill"></i>
                        <span>الخطط العلاجية والتمارين</span>
                    </a>
                }
                else
                {
                    <a asp-controller="TreatmentPlan" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TreatmentPlan" ? "active" : "")">
                        <i class="bi bi-heart-pulse-fill"></i>
                        <span>البرامج العلاجية (اطلاع)</span>
                    </a>
                }

                <div class="nav-category mt-3">التواصل والأتمتة</div>
                <a asp-controller="WhatsApp" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "WhatsApp" ? "active" : "")">
                    <i class="bi bi-whatsapp text-success"></i>
                    <span>رسائل واتساب الآلية</span>
                </a>

                @if (User.IsInRole(ClinicRoles.Admin))
                {
                    <div class="nav-category mt-3">إدارة النظام والأدوار</div>
                    <a asp-controller="Account" asp-action="Users" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>إدارة الطاقم والمستخدمين</span>
                    </a>
                }
            </nav>

            <!-- Sidebar Footer User Card -->
            <div class="sidebar-footer">
                @if (SignInManager.IsSignedIn(User) && currentUser != null)
                {
                    <div class="therapist-profile-pill d-flex align-items-center justify-content-between p-2">
                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                            <div class="therapist-avatar" style="background: var(--primary-gradient);">
                                @(string.IsNullOrEmpty(currentUser.FullName) ? "U" : currentUser.FullName.Substring(0, 1))
                            </div>
                            <div class="overflow-hidden">
                                <div class="fw-bold text-truncate text-dark small">@currentUser.FullName</div>
                                <div class="text-truncate" style="font-size: 0.72rem; color: var(--primary-darker);">
                                    <span class="d-inline-block rounded-circle bg-success me-1" style="width: 7px; height: 7px;"></span>
                                    @currentRole
                                </div>
                            </div>
                        </div>
                        
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-light border-0 text-danger p-1" title="تسجيل الخروج">
                                <i class="bi bi-box-arrow-right fs-6"></i>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-modern btn-modern-primary btn-sm w-100">
                        <i class="bi bi-box-arrow-in-left me-1"></i> تسجيل الدخول
                    </a>
                }
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Topbar Header -->
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light d-xl-none border p-2 rounded-3" type="button" onclick="toggleSidebar()" aria-label="Toggle Menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <!-- Quick Search Input -->
                    <form asp-controller="Clients" asp-action="Index" method="get" class="topbar-search d-none d-md-block">
                        <i class="bi bi-search topbar-search-icon"></i>
                        <input type="text" name="search" placeholder="بحث سريع عن مريض (الاسم، الجوال)..." autocomplete="off" />
                    </form>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="text-muted d-none d-sm-block me-2 small">
                        <i class="bi bi-calendar3 me-1 text-teal" style="color: var(--primary);"></i>
                        @DateTime.Today.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))
                    </div>

                    <!-- Receptionist & Team Live Notification Bell -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown me-2 position-relative" id="notifDropdownContainer">
                            <button type="button" class="btn btn-light position-relative p-2 rounded-circle border shadow-sm d-flex align-items-center justify-content-center" id="notifBellBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="تنبيهات الجلسات والمواعيد القادمة" style="width: 38px; height: 38px;">
                                <i class="bi bi-bell-fill fs-6 text-secondary" id="notifBellIcon"></i>
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none" id="notifDot" style="width: 10px; height: 10px;"></span>
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger d-none" id="notifBadge" style="font-size: 0.65rem; padding: 0.25em 0.5em;">0</span>
                            </button>

                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 notif-dropdown-menu" style="width: 380px; max-width: 92vw; border-radius: 1.1rem; overflow: hidden; z-index: 1060;">
                                <!-- Dropdown Header -->
                                <div class="p-3 text-white d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-bell-fill fs-5"></i>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">تنبيهات الجلسات اليومية</h6>
                                            <small class="text-white-50" id="notifServerTime">مباشر الآن</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 rounded-pill" id="soundToggleBtn" onclick="toggleNotifSound()" title="تفعيل/كتم صوت التنبيه" style="font-size: 0.75rem;">
                                            <i class="bi bi-volume-up-fill" id="soundToggleIcon"></i>
                                            <span id="soundToggleText">صوت: مفعّل</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Filter Tabs -->
                                <ul class="nav nav-pills nav-fill bg-light p-1 border-bottom" id="notifTabs" role="tablist" style="font-size: 0.8rem;">
                                    <li class="nav-item">
                                        <button class="nav-link active py-1 px-2 rounded-pill" id="tab-imminent-btn" data-bs-toggle="pill" data-bs-target="#tab-imminent" type="button">
                                            <span>قادمة قريباً</span>
                                            <span class="badge bg-danger rounded-pill ms-1" id="imminentTabBadge">0</span>
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link py-1 px-2 rounded-pill" id="tab-waiting-btn" data-bs-toggle="pill" data-bs-target="#tab-waiting" type="button">
                                            <span>في الانتظار</span>
                                            <span class="badge bg-success rounded-pill ms-1" id="waitingTabBadge">0</span>
                                        </button>
                                    </li>
                                    <li class="nav-item">
                                        <button class="nav-link py-1 px-2 rounded-pill" id="tab-later-btn" data-bs-toggle="pill" data-bs-target="#tab-later" type="button">
                                            <span>لاحقاً اليوم</span>
                                            <span class="badge bg-secondary rounded-pill ms-1" id="laterTabBadge">0</span>
                                        </button>
                                    </li>
                                </ul>

                                <!-- Tab Content with Scrollable List -->
                                <div class="tab-content" style="max-height: 380px; overflow-y: auto;">
                                    <!-- Imminent Tab -->
                                    <div class="tab-pane fade show active p-2" id="tab-imminent" role="tabpanel">
                                        <div id="imminentListContainer" class="d-flex flex-column gap-2">
                                            <div class="text-center py-4 text-muted small">
                                                <i class="bi bi-check-circle-fill text-success fs-3 d-block mb-1"></i>
                                                لا توجد جلسات حرجة في الـ 45 دقيقة القادمة.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Waiting Room Tab -->
                                    <div class="tab-pane fade p-2" id="tab-waiting" role="tabpanel">
                                        <div id="waitingListContainer" class="d-flex flex-column gap-2">
                                            <div class="text-center py-4 text-muted small">
                                                <i class="bi bi-person-check text-muted fs-3 d-block mb-1"></i>
                                                لا يوجد مرضى بانتظار الجلسة حالياً.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Later Today Tab -->
                                    <div class="tab-pane fade p-2" id="tab-later" role="tabpanel">
                                        <div id="laterListContainer" class="d-flex flex-column gap-2">
                                            <div class="text-center py-4 text-muted small">
                                                لا توجد مواعيد أخرى مجدولة اليوم.
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dropdown Footer -->
                                <div class="p-2 border-top bg-light text-center">
                                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-bold text-teal" style="color: var(--primary);">
                                        <i class="bi bi-calendar2-range me-1"></i> فتح جدول المواعيد والعيادات كاملاً &larr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                    {
                        <a asp-controller="Intake" asp-action="New" class="btn btn-modern btn-modern-outline btn-sm">
                            <i class="bi bi-person-plus"></i>
                            <span class="d-none d-sm-inline">مريض جديد</span>
                        </a>

                        <a asp-controller="Appointments" asp-action="Book" class="btn btn-modern btn-modern-primary btn-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span>حجز جلسة</span>
                        </a>
                    }
                    else if (User.IsInRole(ClinicRoles.Doctor))
                    {
                        <a asp-controller="Consultation" asp-action="Create" class="btn btn-modern btn-modern-outline btn-sm">
                            <i class="bi bi-stethoscope"></i>
                            <span class="d-none d-sm-inline">فحص واستشارة</span>
                        </a>

                        <a asp-controller="Appointments" asp-action="Index" class="btn btn-modern btn-modern-primary btn-sm">
                            <i class="bi bi-calendar2-check"></i>
                            <span>جلساتي اليوم</span>
                        </a>
                    }

                    @if (SignInManager.IsSignedIn(User) && currentUser != null)
                    {
                        <div class="d-flex align-items-center gap-2 ms-2 ps-2 border-start">
                            <span class="badge rounded-pill px-3 py-1 d-none d-lg-inline-block" style="@roleBadgeStyle font-size: 0.78rem; font-weight: 600;">
                                @currentRole
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 d-flex align-items-center gap-1 rounded-pill px-2 py-1" title="تسجيل الخروج">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span class="d-none d-md-inline small">خروج</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </header>

            <!-- Flash Alert Messages -->
            <div class="px-4 pt-3">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 py-3 rounded-3" role="alert" style="background-color: #ecfdf5; color: #065f46; border-right: 5px solid #10b981 !important;">
                        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                        <div class="fw-bold">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 py-3 rounded-3" role="alert" style="background-color: #fef2f2; color: #991b1b; border-right: 5px solid #ef4444 !important;">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                        <div class="fw-bold">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close me-auto ms-0" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            <!-- Page Body -->
            <main class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Hidden Anti-Forgery Form for AJAX requests -->
    <form id="ajaxAntiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- Floating Live Alert Toast Container -->
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 2000;">
        <div id="imminentAlertToast" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 1rem; overflow: hidden; min-width: 320px; background-color: #fff;">
            <div class="toast-header text-white" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
                <i class="bi bi-bell-fill me-2 fs-6"></i>
                <strong class="me-auto" id="toastHeaderTitle">تنبيه موعد قادم!</strong>
                <small class="text-white-50 ms-2" id="toastHeaderTime">الآن</small>
                <button type="button" class="btn-close btn-close-white shadow-none me-auto ms-0" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body p-3">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="zone-avatar" style="width: 42px; height: 42px; background: #ecfdf5; color: #0d9488; border-radius: 12px; font-size: 1.25rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark fs-6" id="toastClientName">اسم المريض</div>
                        <div class="small text-muted" id="toastDetails">مع د. فلان - الساعة 10:30</div>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" id="toastCountdown">يبدأ بعد 10 دقائق</span>
                    <div class="d-flex gap-2" id="toastActionButtons"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Local Bootstrap JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.toggle('show');
            if (backdrop) {
                backdrop.classList.toggle('show');
            }
        }

        // --- Receptionist Real-Time Therapy Notification System ---
        let notifSoundEnabled = localStorage.getItem('physio_notif_sound') !== 'false';
        const notifiedAppointmentIds = new Set();

        function updateSoundUI() {
            const icon = document.getElementById('soundToggleIcon');
            const text = document.getElementById('soundToggleText');
            if (!icon || !text) return;
            if (notifSoundEnabled) {
                icon.className = 'bi bi-volume-up-fill';
                text.innerText = 'صوت: مفعّل';
            } else {
                icon.className = 'bi bi-volume-mute-fill text-warning';
                text.innerText = 'صوت: مكتوم';
            }
        }

        function toggleNotifSound() {
            notifSoundEnabled = !notifSoundEnabled;
            localStorage.setItem('physio_notif_sound', notifSoundEnabled);
            updateSoundUI();
        }

        // Web Audio API Synthesized Chime (Zero External Files)
        function playChime() {
            if (!notifSoundEnabled) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                
                // Tone 1: 587.33 Hz (D5)
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.type = 'sine';
                osc1.frequency.setValueAtTime(587.33, ctx.currentTime);
                gain1.gain.setValueAtTime(0.25, ctx.currentTime);
                gain1.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.start(ctx.currentTime);
                osc1.stop(ctx.currentTime + 0.35);

                // Tone 2: 880 Hz (A5) slightly after
                setTimeout(() => {
                    try {
                        const osc2 = ctx.createOscillator();
                        const gain2 = ctx.createGain();
                        osc2.type = 'sine';
                        osc2.frequency.setValueAtTime(880, ctx.currentTime);
                        gain2.gain.setValueAtTime(0.3, ctx.currentTime);
                        gain2.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        osc2.start(ctx.currentTime);
                        osc2.stop(ctx.currentTime + 0.5);
                    } catch(e) {}
                }, 120);
            } catch(e) { }
        }

        async function quickConfirmAttendanceAjax(apptId) {
            const tokenInput = document.querySelector('#ajaxAntiForgeryForm input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            try {
                const formData = new FormData();
                formData.append('id', apptId);
                formData.append('__RequestVerificationToken', token);

                const response = await fetch('/Appointments/QuickConfirmAttendance', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        // Refresh notifications immediately
                        loadUpcomingAlerts();
                    }
                }
            } catch (err) {
                console.error('Error confirming attendance:', err);
            }
        }

        function showImminentToast(item) {
            const toastEl = document.getElementById('imminentAlertToast');
            if (!toastEl) return;

            document.getElementById('toastHeaderTitle').innerText = 'تنبيه موعد قادم!';
            document.getElementById('toastHeaderTime').innerText = item.startTime;
            document.getElementById('toastClientName').innerText = item.clientName;
            document.getElementById('toastDetails').innerText = `مع ${item.therapistTitle} ${item.therapistName} (${item.sessionType})`;
            document.getElementById('toastCountdown').innerText = `يبدأ ${item.statusText}`;

            const actionContainer = document.getElementById('toastActionButtons');
            actionContainer.innerHTML = `
                <button type="button" class="btn btn-sm btn-primary py-1 px-2" onclick="quickConfirmAttendanceAjax(${item.id}); bootstrap.Toast.getInstance(document.getElementById('imminentAlertToast'))?.hide();">
                    <i class="bi bi-person-check-fill me-1"></i> وصل بالعيادة
                </button>
            `;

            if (item.phone) {
                actionContainer.innerHTML += `
                    <a href="https://wa.me/${item.phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('مرحباً بك ' + item.clientName + '، نذكرك بموعد جلستك العلاجية اليوم الساعة ' + item.startTime)}" target="_blank" class="btn btn-sm btn-outline-success py-1 px-2" title="واتساب">
                        <i class="bi bi-whatsapp"></i>
                    </a>
                `;
            }

            const toast = new bootstrap.Toast(toastEl, { delay: 10000 });
            toast.show();
        }

        async function loadUpcomingAlerts() {
            const bellBadge = document.getElementById('notifBadge');
            const bellDot = document.getElementById('notifDot');
            const bellIcon = document.getElementById('notifBellIcon');
            const serverTimeEl = document.getElementById('notifServerTime');
            if (!bellBadge) return;

            try {
                const response = await fetch('/Appointments/GetUpcomingAlerts');
                if (!response.ok) return;
                const data = await response.json();
                if (!data.success) return;

                if (serverTimeEl) {
                    serverTimeEl.innerText = `الساعة الآن: ${data.serverTime}`;
                }

                // Update tab counters
                const immCount = data.imminentCount || 0;
                const waitCount = data.waitingCount || 0;
                const laterCount = (data.upcomingToday || []).length;

                document.getElementById('imminentTabBadge').innerText = immCount;
                document.getElementById('waitingTabBadge').innerText = waitCount;
                document.getElementById('laterTabBadge').innerText = laterCount;

                const totalAlerts = immCount + waitCount;
                if (totalAlerts > 0) {
                    bellBadge.innerText = totalAlerts;
                    bellBadge.classList.remove('d-none');
                    bellDot.classList.remove('d-none');
                    bellIcon.className = 'bi bi-bell-fill fs-6 text-danger animate-pulse';
                } else {
                    bellBadge.classList.add('d-none');
                    bellDot.classList.add('d-none');
                    bellIcon.className = 'bi bi-bell-fill fs-6 text-secondary';
                }

                // Render Imminent Tab
                const immContainer = document.getElementById('imminentListContainer');
                if (data.imminent && data.imminent.length > 0) {
                    let html = '';
                    let hasNewImminent = false;

                    data.imminent.forEach(item => {
                        if (!notifiedAppointmentIds.has(item.id)) {
                            notifiedAppointmentIds.add(item.id);
                            hasNewImminent = true;
                            showImminentToast(item);
                        }

                        html += `
                            <div class="card border border-warning-subtle shadow-sm p-2 rounded-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold" style="font-size: 0.72rem;">
                                        <i class="bi bi-clock-history me-1"></i> ${item.statusText}
                                    </span>
                                    <span class="fw-bold text-dark" style="font-size: 0.85rem;">
                                        <i class="bi bi-clock me-1 text-primary"></i> ${item.startTime}
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="zone-avatar" style="width: 32px; height: 32px; background: #ecfdf5; color: #0d9488; border-radius: 8px; font-size: 0.9rem;">
                                        <i class="bi bi-person"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="fw-bold text-truncate text-dark small">${item.clientName}</div>
                                        <small class="text-muted d-block text-truncate" style="font-size: 0.72rem;">
                                            <span class="badge text-white px-1 py-0 me-1" style="background-color: ${item.therapistColor};">${item.therapistName}</span>
                                            ${item.sessionType}
                                        </small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1 justify-content-end pt-1 border-top">
                                    <button type="button" class="btn btn-sm btn-primary py-0 px-2 rounded-pill" style="font-size: 0.75rem;" onclick="quickConfirmAttendanceAjax(${item.id})">
                                        <i class="bi bi-person-check-fill me-1"></i> وصل بالعيادة
                                    </button>
                                    ${item.phone ? `
                                        <a href="https://wa.me/${item.phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('مرحباً بك ' + item.clientName + '، نذكرك بموعد جلستك اليوم الساعة ' + item.startTime)}" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                            <i class="bi bi-whatsapp"></i>
                                        </a>
                                    ` : ''}
                                </div>
                            </div>
                        `;
                    });

                    immContainer.innerHTML = html;
                    if (hasNewImminent) {
                        playChime();
                    }
                } else {
                    immContainer.innerHTML = `
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-check-circle-fill text-success fs-3 d-block mb-1"></i>
                            لا توجد جلسات حرجة في الـ 45 دقيقة القادمة.
                        </div>
                    `;
                }

                // Render Waiting Room Tab
                const waitContainer = document.getElementById('waitingListContainer');
                if (data.waiting && data.waiting.length > 0) {
                    let html = '';
                    data.waiting.forEach(item => {
                        html += `
                            <div class="card border border-success-subtle shadow-sm p-2 rounded-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-success text-white" style="font-size: 0.7rem;">
                                        <i class="bi bi-person-check-fill me-1"></i> حاضر بصالة الانتظار
                                    </span>
                                    <span class="small text-muted fw-bold">${item.startTime}</span>
                                </div>
                                <div class="fw-bold text-dark small mb-1">${item.clientName}</div>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">
                                    مع المعالج: <strong>${item.therapistName}</strong> (${item.sessionType})
                                </small>
                            </div>
                        `;
                    });
                    waitContainer.innerHTML = html;
                } else {
                    waitContainer.innerHTML = `
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-person-check text-muted fs-3 d-block mb-1"></i>
                            لا يوجد مرضى بانتظار الجلسة حالياً.
                        </div>
                    `;
                }

                // Render Later Today Tab
                const laterContainer = document.getElementById('laterListContainer');
                if (data.upcomingToday && data.upcomingToday.length > 0) {
                    let html = '';
                    data.upcomingToday.forEach(item => {
                        html += `
                            <div class="card border shadow-sm p-2 rounded-3 bg-white">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="fw-bold text-primary" style="font-size: 0.8rem;">
                                        <i class="bi bi-clock me-1"></i> ${item.startTime}
                                    </span>
                                    <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">${item.statusText}</span>
                                </div>
                                <div class="fw-bold text-dark small">${item.clientName}</div>
                                <small class="text-muted d-block" style="font-size: 0.72rem;">مع: ${item.therapistName}</small>
                            </div>
                        `;
                    });
                    laterContainer.innerHTML = html;
                } else {
                    laterContainer.innerHTML = `
                        <div class="text-center py-4 text-muted small">
                            لا توجد مواعيد أخرى مجدولة اليوم.
                        </div>
                    `;
                }

            } catch (err) {
                console.error('Error fetching upcoming alerts:', err);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            updateSoundUI();
            loadUpcomingAlerts();
            // Poll every 30 seconds
            setInterval(loadUpcomingAlerts, 30000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
