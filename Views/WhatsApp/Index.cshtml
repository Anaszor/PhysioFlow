@using PhysioClinic.Services.WhatsApp
@{
    ViewData["Title"] = "إدارة أتمتة رسائل واتساب";
    var settings = ViewBag.Settings as WhatsAppSettings ?? new WhatsAppSettings();
    var status = ViewBag.Status as WhatsAppSessionStatus ?? new WhatsAppSessionStatus();
    var qrCode = ViewBag.QrCode as string;
    var pairingCode = ViewBag.PairingCode as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success p-2 rounded-circle fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-whatsapp"></i>
            </span>
            <div>
                <h3 class="fw-bold mb-0 text-dark">نظام أتمتة رسائل واتساب للعيادة</h3>
                <p class="text-muted mb-0 small">ربط وإرسال الإشعارات وتأكيدات المواعيد للمرضى آلياً عبر رقمك الرسمي (@settings.SenderNumber)</p>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-modern btn-modern-soft btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i> تحديث الحالة
        </a>
    </div>
</div>

<!-- Status Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-modern p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">حالة اتصال البوابة المحلية</span>
                <span class="badge @(status.IsServerReachable ? "bg-success" : "bg-danger") px-2 py-1">
                    @(status.IsServerReachable ? "متصل بالبوابة" : "البوابة غير متصلة")
                </span>
            </div>
            <h5 class="fw-bold text-dark mb-1">
                <i class="bi bi-hdd-network me-1 text-primary"></i> localhost:2785
            </h5>
            <small class="text-muted">مجلد: C:\Users\Owner\Downloads\Whatsapp Automation</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-modern p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">حالة جلسة الواتساب</span>
                <span class="badge @(status.IsReady ? "bg-success" : (status.Status == "qr_ready" ? "bg-warning text-dark" : "bg-secondary")) px-2 py-1" id="badgeSessionStatus">
                    @(status.IsReady ? "متصل وجاهز للإرسال 🟢" : (status.Status == "qr_ready" ? "بانتظار ربط الهاتف 🟡" : status.Status))
                </span>
            </div>
            <h5 class="fw-bold text-dark mb-1" id="textSessionPhone">
                @(status.IsReady ? (status.Phone ?? settings.SenderNumber) : (status.Status == "qr_ready" ? "بانتظار المسح أو الكود" : "غير متصل"))
            </h5>
            <small class="text-muted">جلسة: physioclinic (@settings.SessionId.Substring(0, 8)...)</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-modern p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">رقم الإرسال المعتمد</span>
                <span class="badge bg-primary-subtle text-primary px-2 py-1">الأردن (+962)</span>
            </div>
            <h5 class="fw-bold text-dark mb-1 dir-ltr text-end">@settings.SenderNumber</h5>
            <small class="text-muted">ترسل التأكيدات والتذكيرات باسم: @settings.ClinicName</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Linking / Pairing Card -->
    <div class="col-lg-6">
        <div class="card-modern p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-qr-code-scan me-1 text-success"></i> ربط رقمك بالواتساب (@settings.SenderNumber)
                </h5>
                @if (status.Status != "ready" && status.Status != "qr_ready")
                {
                    <form asp-action="Start" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-modern btn-modern-primary">
                            <i class="bi bi-play-circle me-1"></i> تشغيل الجلسة
                        </button>
                    </form>
                }
            </div>

            @if (status.IsReady)
            {
                <div class="text-center py-4">
                    <div class="mb-3">
                        <span class="rounded-circle bg-success text-white p-3 d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2rem;">
                            <i class="bi bi-check-lg"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-success mb-2">تم ربط رقم الواتساب بنجاح!</h5>
                    <p class="text-muted small mb-3">الرقم المتصل حالياً: <strong>@(status.Phone ?? settings.SenderNumber)</strong> (@(status.PushName ?? "PhysioFlow"))</p>
                    <div class="alert alert-success d-inline-block small text-start px-3 py-2">
                        <i class="bi bi-shield-check me-1"></i> النظام يرسل الآن رسائل الواتساب الآلية للمرضى بنجاح عند حجز المواعيد أو إرسال التذكيرات.
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <p class="text-muted small">
                        يمكنك ربط واتساب مباشرة برقمك عبر <strong>كود الربط المكون من 8 خانات</strong> دون الحاجة لتوجيه الكاميرا، أو عبر مسح رمز الاستجابة السريعة (QR Code).
                    </p>
                </div>

                <!-- Pairing Code Section -->
                <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-key-fill text-warning me-1"></i> الخيار الأسهل: كود الربط بالهاتف (Pairing Code)
                        </h6>
                    </div>

                    <form asp-action="RequestPairing" method="post" class="d-flex gap-2 mb-3">
                        @Html.AntiForgeryToken()
                        <input type="text" name="phoneNumber" value="@settings.SenderNumber" class="form-control form-control-modern text-center fw-bold dir-ltr" placeholder="+962786363593" style="max-width: 220px;" />
                        <button type="submit" class="btn btn-modern btn-modern-primary flex-grow-1">
                            <i class="bi bi-phone me-1"></i> توليد كود الربط لرقمي
                        </button>
                    </form>

                    @if (!string.IsNullOrEmpty(pairingCode))
                    {
                        <div class="text-center p-3 bg-white rounded-3 border border-success border-2 shadow-sm mb-3">
                            <span class="text-muted small d-block mb-1">كود الربط الخاص بك (صالح لمدة دقيقة):</span>
                            <div class="fs-1 fw-bold tracking-wider text-success dir-ltr py-1 user-select-all" id="displayPairingCode">
                                @pairingCode
                            </div>
                            <small class="text-muted">أدخل هذا الكود في تطبيق واتساب على هاتفك الآن</small>
                        </div>
                    }

                    <div class="small text-muted bg-white p-2 rounded-2 border">
                        <strong class="d-block text-dark mb-1">طريقة الإدخال في هاتفك:</strong>
                        <ol class="mb-0 ps-3 pe-0">
                            <li>افتح واتساب في هاتفك (@settings.SenderNumber).</li>
                            <li>اضغط على (الإعدادات ⚙️ أو النقاط الثلاث) ثم <strong>الأجهزة المرتبطة (Linked Devices)</strong>.</li>
                            <li>اضغط على <strong>ربط جهاز (Link a Device)</strong>.</li>
                            <li>اضغط في الأسفل على <strong>"الربط برقم الهاتف بدلاً من ذلك" (Link with phone number instead)</strong>.</li>
                            <li>أدخل الكود المكون من 8 أحرف وأرقام الظاهر أعلاه.</li>
                        </ol>
                    </div>
                </div>

                <!-- QR Code Alternative -->
                <div class="card bg-light border-0 p-3 rounded-3 text-center">
                    <h6 class="fw-bold mb-2 text-dark">
                        <i class="bi bi-qr-code text-primary me-1"></i> أو امسح رمز QR بواسطة كاميرا واتساب
                    </h6>
                    <div class="d-flex justify-content-center my-2" id="qrContainer">
                        @if (!string.IsNullOrEmpty(qrCode))
                        {
                            <img src="@qrCode" alt="WhatsApp QR Code" class="img-fluid rounded-3 shadow-sm border bg-white p-2" style="max-width: 200px;" id="qrImage" />
                        }
                        else
                        {
                            <div class="p-4 bg-white rounded-3 border text-muted small" style="min-width: 180px;">
                                <i class="bi bi-hourglass-split fs-3 d-block mb-1"></i>
                                جاري تجهيز رمز QR...
                            </div>
                        }
                    </div>
                    <small class="text-muted">يتم تحديث الرمز تلقائياً كل دقيقة حتى يتم المسح والربط.</small>
                </div>
            }
        </div>
    </div>

    <!-- Test Message & Automation Preview -->
    <div class="col-lg-6">
        <!-- Test Message Card -->
        <div class="card-modern p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-send-fill me-1 text-primary"></i> إرسال رسالة واتساب تجريبية
            </h5>
            <p class="text-muted small">
                يمكنك تجربة إرسال رسالة فورية لأي رقم هاتف للتحقق من الاتصال ووصول الرسالة.
            </p>

            <form asp-action="SendTest" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small fw-semibold">رقم هاتف المستقبل</label>
                    <input type="text" name="phone" value="@settings.SenderNumber" class="form-control form-control-modern dir-ltr text-end" placeholder="+962786363593 أو 0786363593" required />
                    <small class="text-muted">يدعم الأرقام الأردنية (07XXXXXXXX أو +962) والدولية مباشرة.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">نص الرسالة</label>
                    <textarea name="message" rows="3" class="form-control form-control-modern" required>مرحباً بك! هذه رسالة تجريبية من نظام أتمتة عيادة PhysioFlow عبر الواتساب 🌿✨</textarea>
                </div>

                <button type="submit" class="btn btn-modern btn-modern-primary w-100" @(status.IsReady ? "" : "disabled")>
                    <i class="bi bi-send-fill me-1"></i> إرسال الرسالة الآن
                </button>
                @if (!status.IsReady)
                {
                    <small class="text-danger d-block mt-2 text-center">
                        <i class="bi bi-exclamation-triangle me-1"></i> يجب ربط الهاتف أولاً لتفعيل زر الإرسال.
                    </small>
                }
            </form>
        </div>

        <!-- Automation Features Overview -->
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-robot me-1 text-teal"></i> الرسائل الآلية المدمجة في النظام
            </h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-start gap-3 p-2 bg-light rounded-3">
                    <span class="badge bg-success-subtle text-success p-2 rounded-circle fs-6">
                        <i class="bi bi-calendar-check"></i>
                    </span>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-dark small">تأكيد حجز الموعد الفوري</strong>
                            <span class="badge bg-success">مفعل آلياً</span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            عند قيام موظف الاستقبال أو الطبيب بحجز موعد لأي مريض، يتم إرسال رسالة واتساب فورية للمريض تتضمن التاريخ، الوقت، اسم الطبيب المعالج، وتفاصيل الجلسة.
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 p-2 bg-light rounded-3">
                    <span class="badge bg-primary-subtle text-primary p-2 rounded-circle fs-6">
                        <i class="bi bi-bell-fill"></i>
                    </span>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-dark small">تذكير المريض بالموعد بنقرة واحدة</strong>
                            <span class="badge bg-primary">متاح في جدول المواعيد</span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            زر مخصص بجانب كل موعد في جدول المواعيد لإرسال رسالة تذكيرية ودية للمريض لحثه على الحضور قبل موعده.
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 p-2 bg-light rounded-3">
                    <span class="badge bg-danger-subtle text-danger p-2 rounded-circle fs-6">
                        <i class="bi bi-x-circle-fill"></i>
                    </span>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-dark small">إشعار إلغاء الموعد</strong>
                            <span class="badge bg-success">مفعل آلياً</span>
                        </div>
                        <p class="text-muted small mb-0 mt-1">
                            في حال تم إلغاء موعد المريض مع كتابة سبب الإلغاء، يتم إرسال اعتذار وإشعار فوري له عبر الواتساب مع رقم العيادة لإعادة الجدولة.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh status every 6 seconds if not ready
        @if (!status.IsReady)
        {
            <text>
            setInterval(function() {
                fetch('/WhatsApp/LiveStatus')
                    .then(response => response.json())
                    .then(data => {
                        if (data.isReady) {
                            window.location.reload();
                        } else if (data.status === 'qr_ready') {
                            var badge = document.getElementById('badgeSessionStatus');
                            if (badge) {
                                badge.className = 'badge bg-warning text-dark px-2 py-1';
                                badge.textContent = 'بانتظار ربط الهاتف 🟡';
                            }
                            if (data.qrCode) {
                                var qrContainer = document.getElementById('qrContainer');
                                if (qrContainer) {
                                    qrContainer.innerHTML = '<img src="' + data.qrCode + '" alt="WhatsApp QR Code" class="img-fluid rounded-3 shadow-sm border bg-white p-2" style="max-width: 200px;" id="qrImage" />';
                                }
                            }
                        }
                    })
                    .catch(err => console.log('Status polling error:', err));
            }, 6000);
            </text>
        }
    </script>
}
