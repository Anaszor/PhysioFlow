@using PhysioClinic.Services.WhatsApp
@{
    ViewData["Title"] = "إدارة أتمتة رسائل واتساب السحابية";
    var settings = ViewBag.Settings as WhatsAppSettings ?? new WhatsAppSettings();
    var status = ViewBag.Status as WhatsAppSessionStatus ?? new WhatsAppSessionStatus();
    var qrCode = ViewBag.QrCode as string;
    var pairingCode = ViewBag.PairingCode as string;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success p-2 rounded-circle fs-5 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="bi bi-whatsapp"></i>
            </span>
            <div>
                <h3 class="fw-bold mb-0 text-dark">أتمتة رسائل واتساب السحابية</h3>
                <p class="text-muted mb-0 small">خدمة مدمجة سحابياً 100% لإرسال تأكيدات وإشعارات المواعيد آلياً من الخادم دون الحاجة لأي برامج محلية</p>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-modern btn-modern-soft btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i> فحص الاتصال وتحديث الحالة
        </a>
    </div>
</div>

<!-- Status Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-modern p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">نوع المزود السحابي</span>
                <span class="badge bg-primary-subtle text-primary px-2 py-1">Direct Cloud API</span>
            </div>
            <h5 class="fw-bold text-dark mb-1">
                <i class="bi bi-cloud-check-fill me-1 text-success"></i> @settings.Provider
            </h5>
            <small class="text-muted">يعمل مباشرة من السيرفر السحابي (MonsterASP)</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-modern p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">حالة الربط والإرسال</span>
                <span class="badge @(status.IsReady ? "bg-success" : (status.Status == "qr_ready" ? "bg-warning text-dark" : (status.Status == "not_configured" ? "bg-info text-dark" : "bg-secondary"))) px-2 py-1" id="badgeSessionStatus">
                    @(status.IsReady ? "متصل وجاهز للإرسال 🟢" : (status.Status == "qr_ready" ? "بانتظار مسح رمز QR 🟡" : (status.Status == "not_configured" ? "بحاجة لإدخال المفاتيح ⚙️" : status.Status)))
                </span>
            </div>
            <h5 class="fw-bold text-dark mb-1" id="textSessionPhone">
                @(status.IsReady ? (status.Phone ?? settings.SenderNumber) : (status.Status == "qr_ready" ? "امسح الـ QR للربط" : "غير مربوط"))
            </h5>
            <small class="text-muted">
                @(string.IsNullOrEmpty(settings.InstanceId) ? "لم يتم ضبط معرّف الحساب بعد" : $"معرّف الحساب: {settings.InstanceId}")
            </small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-modern p-3 h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">رقم الإرسال المعتمد</span>
                <span class="badge bg-success px-2 py-1">نشط</span>
            </div>
            <h5 class="fw-bold text-dark mb-1 dir-ltr text-end">@settings.SenderNumber</h5>
            <small class="text-muted">اسم المرسل: @settings.ClinicName</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cloud Configuration Card -->
    <div class="col-lg-6">
        <div class="card-modern p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-sliders me-1 text-primary"></i> إعدادات المزود السحابي المباشر
                </h5>
                <span class="badge bg-light text-dark border">تحديث فوري</span>
            </div>

            <p class="text-muted small mb-3">
                يتم الإرسال السحابي الآلي مباشرة عبر المزود (مثل <strong>Green-API</strong> أو <strong>UltraMsg</strong>) دون الحاجة لأي برامج على جهازك.
            </p>

            <form asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label small fw-semibold">المزود (Provider)</label>
                    <select name="provider" id="providerSelect" class="form-select form-control-modern" onchange="toggleProviderFields()">
                        <option value="Gateway" selected="@(settings.Provider == "Gateway")">بوابة الواتساب الخاصة بي (My WhatsApp Gateway)</option>
                        <option value="GreenApi" selected="@(settings.Provider == "GreenApi")">Green-API (سحابي مباشر)</option>
                        <option value="UltraMsg" selected="@(settings.Provider == "UltraMsg")">UltraMsg (سحابي مباشر)</option>
                    </select>
                </div>

                <div class="mb-3" id="apiUrlDiv">
                    <label class="form-label small fw-semibold">رابط البوابة (Gateway URL / Server URL)</label>
                    <input type="text" name="apiUrl" id="inputApiUrl" value="@settings.ApiUrl" class="form-control form-control-modern dir-ltr" placeholder="https://xxx.trycloudflare.com أو http://localhost:2785" />
                    <small class="text-muted">رابط خادم أتمتة الواتساب الخاص بك</small>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" id="labelInstanceId">معرّف الجلسة (Session ID)</label>
                        <input type="text" name="instanceId" value="@settings.InstanceId" class="form-control form-control-modern dir-ltr" placeholder="5566fa92-1d24-4599-8321-d38aec69f931" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" id="labelApiToken">مفتاح API الخاص بك (API Key)</label>
                        <input type="password" name="apiToken" value="@settings.ApiToken" class="form-control form-control-modern dir-ltr" placeholder="owa_k1_..." required />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">رقم هاتف العيادة المرسل</label>
                        <input type="text" name="senderNumber" value="@settings.SenderNumber" class="form-control form-control-modern dir-ltr text-end" placeholder="+962786363593" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">اسم العيادة في الرسائل</label>
                        <input type="text" name="clinicName" value="@settings.ClinicName" class="form-control form-control-modern" required />
                    </div>
                </div>

                <div class="mb-3 p-3 bg-light rounded-3">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="autoSendOnBooking" value="true" id="chkBooking" @(settings.AutoSendOnBooking ? "checked" : "") />
                        <label class="form-check-label small fw-semibold" for="chkBooking">
                            إرسال تأكيد الحجز للمريض تلقائياً عند حجز الجلسة
                        </label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" name="autoSendOnCancel" value="true" id="chkCancel" @(settings.AutoSendOnCancel ? "checked" : "") />
                        <label class="form-check-label small fw-semibold" for="chkCancel">
                            إرسال إشعار للمريض تلقائياً عند إلغاء الجلسة
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-modern btn-modern-primary w-100">
                    <i class="bi bi-save me-1"></i> حفظ وتطبيق الإعدادات
                </button>
            </form>
        </div>

        <!-- How to get free credentials box -->
        <div class="card border-0 bg-light p-3 rounded-3">
            <h6 class="fw-bold mb-2 text-dark">
                <i class="bi bi-info-circle-fill text-info me-1"></i> كيف تحصل على مفاتيح الربط المجانية في دقيقتين؟
            </h6>
            <ol class="small text-muted mb-0 ps-3">
                <li>ادخل وسجل مجاناً في موقع <strong><a href="https://green-api.com" target="_blank" class="text-decoration-none fw-semibold">Green-API.com</a></strong> (أو <a href="https://ultramsg.com" target="_blank" class="text-decoration-none fw-semibold">UltraMsg.com</a>).</li>
                <li>ستحصل فوراً على حساب تجريبي مجاني يظهر لك فيه: <strong>IdInstance</strong> و <strong>ApiToken</strong>.</li>
                <li>امسح رمز الـ QR الظاهر في لوحة تحكمهم بواسطة واتساب على هاتفك لمرة واحدة فقط.</li>
                <li>انسخ الـ IdInstance والـ ApiToken والصقهما في النموذج أعلاه واضغط <strong>حفظ</strong>.</li>
            </ol>
        </div>
    </div>

    <!-- Right Column: QR Scan & Test Message -->
    <div class="col-lg-6">
        @if (!string.IsNullOrEmpty(qrCode))
        {
            <!-- QR Code Card -->
            <div class="card-modern p-4 mb-4 text-center">
                <h5 class="fw-bold mb-2 text-dark">
                    <i class="bi bi-qr-code-scan text-success me-1"></i> امسح رمز الاستجابة السريعة (QR Code)
                </h5>
                <p class="text-muted small mb-3">افتح واتساب في هاتفك > الأجهزة المرتبطة > ربط جهاز > وجّه الكاميرا نحو الرمز التالي:</p>

                <div class="d-flex justify-content-center my-3" id="qrContainer">
                    <img src="@qrCode" alt="WhatsApp QR Code" class="img-fluid rounded-3 shadow border bg-white p-3" style="max-width: 240px;" id="qrImage" />
                </div>
                <small class="text-muted d-block">يتم تحديث الرمز تلقائياً حتى يكتمل الربط.</small>
            </div>
        }

        <!-- Test Message Card -->
        <div class="card-modern p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-send-fill me-1 text-primary"></i> إرسال رسالة واتساب تجريبية فورية
            </h5>
            <p class="text-muted small">
                يمكنك تجربة إرسال رسالة فورية لأي رقم هاتف للتحقق من الاتصال ووصول الرسالة.
            </p>

            <form asp-action="SendTest" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small fw-semibold">رقم هاتف المستقبل</label>
                    <input type="text" name="phone" value="@settings.SenderNumber" class="form-control form-control-modern dir-ltr text-end" placeholder="+962786363593 أو 0786363593" required />
                    <small class="text-muted">يدعم الأرقام الأردنية (07XXXXXXXX أو +962) والدولية مباشرة.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">نص الرسالة</label>
                    <textarea name="message" rows="3" class="form-control form-control-modern" required>مرحباً بك! هذه رسالة تجريبية من نظام أتمتة عيادة PhysioFlow عبر الواتساب السحابي 🌿✨</textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-modern btn-modern-success flex-grow-1">
                        <i class="bi bi-send-check me-1"></i> إرسال آلي عبر السحابة
                    </button>
                    <a href="https://wa.me/962786363593?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%A8%D9%83%20%D9%85%D9%86%20%D8%B9%D9%8A%D8%A7%D8%AF%D8%A9%20%D9%81%D9%8A%D8%B2%D9%8A%D9%88%20%D9%81%D9%84%D9%88" target="_blank" class="btn btn-modern btn-modern-soft" title="فتح محادثة واتساب ويب مباشرة">
                        <i class="bi bi-box-arrow-up-right me-1"></i> فتح WhatsApp Web
                    </a>
                </div>
            </form>
        </div>

        <!-- Automation Features Info -->
        <div class="card-modern p-4">
            <h6 class="fw-bold mb-3 text-dark">
                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> ميزات الأتمتة المفعّلة في النظام
            </h6>
            <div class="list-group list-group-flush small">
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                    <div>
                        <strong>تأكيد الحجز الفوري:</strong>
                        <div class="text-muted">إرسال تفاصيل الموعد واسم الأخصائي ورقم الجلسة تلقائياً للمريض فور حجز الجلسة.</div>
                    </div>
                    <span class="badge bg-success-subtle text-success">تلقائي 100%</span>
                </div>
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                    <div>
                        <strong>إشعار الإلغاء:</strong>
                        <div class="text-muted">إرسال إشعار اعتذار وإلغاء للمريض مع سبب الإلغاء عند إلغاء الجلسة من الجدول.</div>
                    </div>
                    <span class="badge bg-success-subtle text-success">تلقائي 100%</span>
                </div>
                <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                    <div>
                        <strong>زر التذكير بنقرة واحدة:</strong>
                        <div class="text-muted">زر أخضر متاح في جدول المواعيد لإرسال تذكير فوري لأي مريض بنقرة زر.</div>
                    </div>
                    <span class="badge bg-info-subtle text-info">يدوي وسريع</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh status if QR code is waiting
        @if (status.Status == "qr_ready")
        {
            <text>
            setInterval(function() {
                fetch('/WhatsApp/LiveStatus')
                    .then(res => res.json())
                    .then(data => {
                        if (data.isReady) {
                            window.location.reload();
                        }
                    })
                    .catch(err => console.log('Polling status...', err));
            }, 5000);
            </text>
        }
    </script>
}
