@model PhysioClinic.ViewModels.CreateStaffViewModel
@{
    ViewData["Title"] = "إضافة موظف جديد";
    var therapists = ViewBag.Therapists as List<PhysioClinic.Models.Therapist> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">إضافة مستخدم جديد للنظام 👤</h3>
                <p class="text-muted mb-0">إنشاء حساب جديد وتعيين الصلاحيات والدور الوظيفي المناسب.</p>
            </div>
            <a asp-action="Users" class="btn btn-modern btn-modern-outline">
                <i class="bi bi-arrow-right me-1"></i> العودة للمستخدمين
            </a>
        </div>

        <form asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

            <div class="card-modern mb-4">
                <div class="card-modern-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="zone-avatar" style="width: 36px; height: 36px; background-color: var(--primary-light); color: var(--primary-dark);">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-dark">بيانات الحساب الأساسية</h6>
                    </div>
                </div>

                <div class="card-modern-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label-modern">الاسم الكامل <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control form-control-modern" placeholder="مثال: د. عبد الله السالم" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-modern">البريد الإلكتروني المهني <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control form-control-modern font-monospace" placeholder="user@physioflow.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label-modern">كلمة المرور الأولية <span class="text-danger">*</span></label>
                            <input asp-for="Password" type="password" class="form-control form-control-modern" placeholder="على الأقل 6 أحرف" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label-modern">الدور والصلاحيات (Role) <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-select form-select-modern" id="roleSelector" onchange="toggleTherapistLink()">
                                <option value="Admin">مدير النظام (Admin) - كامل الصلاحيات</option>
                                <option value="Doctor">طبيب / أخصائي معالج (Doctor) - فحص، خطط، إنجاز</option>
                                <option value="Receptionist">موظف استقبال (Receptionist) - حجز واستبيان فقط</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RoleTitle" class="form-label-modern">المسمى الوظيفي التفصيلي</label>
                            <input asp-for="RoleTitle" class="form-control form-control-modern" placeholder="مثال: أخصائي تأهيل رياضي أول" />
                        </div>

                        <div class="col-md-6" id="therapistGroup" style="display: none;">
                            <label asp-for="TherapistId" class="form-label-modern">ربط بملف أخصائي معتمد</label>
                            <select asp-for="TherapistId" class="form-select form-select-modern">
                                <option value="">-- غير مرتبط بملف أخصائي محدد --</option>
                                @foreach (var th in therapists)
                                {
                                    <option value="@th.Id">@th.FullName (@th.Specialization)</option>
                                }
                            </select>
                            <small class="text-muted d-block mt-1">يسمح بربط جدول مواعيده وجلساته بالعيادة تلقائياً.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Users" class="btn btn-modern btn-modern-outline">إلغاء</a>
                <button type="submit" class="btn btn-modern btn-modern-primary px-4">
                    <i class="bi bi-check2-circle me-1"></i> حفظ وتفعيل الحساب
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleTherapistLink() {
            const role = document.getElementById('roleSelector').value;
            const group = document.getElementById('therapistGroup');
            if (role === 'Doctor') {
                group.style.display = 'block';
            } else {
                group.style.display = 'none';
            }
        }
        document.addEventListener('DOMContentLoaded', toggleTherapistLink);
    </script>
}
