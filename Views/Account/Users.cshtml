@model IEnumerable<PhysioClinic.ViewModels.UserItemViewModel>
@{
    ViewData["Title"] = "إدارة المستخدمين والصلاحيات";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">إدارة الطاقم والمستخدمين والصلاحيات 👥</h3>
        <p class="text-muted mb-0">التحكم في حسابات الأطباء، موظفي الاستقبال، ومسؤولي النظام (ASP.NET Identity Roles).</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Therapists" asp-action="Index" class="btn btn-modern btn-modern-soft">
            <i class="bi bi-person-badge-fill me-1"></i> طاقم الأطباء والأخصائيين
        </a>
        <a asp-action="CreateUser" class="btn btn-modern btn-modern-primary">
            <i class="bi bi-person-plus-fill me-1"></i> إضافة موظف جديد
        </a>
    </div>
</div>

<!-- Info Alert for Patients distinction -->
<div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 py-3 rounded-3 mb-4" style="background-color: #f0fdf4; color: #166534; border-right: 5px solid #16a34a !important;">
    <i class="bi bi-info-circle-fill fs-4 text-success"></i>
    <div class="small">
        <strong>ملاحظة هامة حول الصلاحيات:</strong>
        النظام مصمم ليمنح حق تسجيل الدخول لكوادر العيادة فقط (المدير، الأخصائي، موظف الاستقبال).
        <strong>المرضى (Clients)</strong> لا يمتلكون حسابات تسجيل دخول، وتتم إدارة ملفاتهم الطبية واستبياناتهم من قِبل الفريق الطبي مباشرة.
    </div>
</div>

<div class="card-modern">
    <div class="table-responsive">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>الموظف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الدور الوظيفي (Role)</th>
                    <th>المسمى التفصيلي</th>
                    <th>الأخصائي المرتبط</th>
                    <th>تاريخ التسجيل</th>
                    <th class="text-start">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="therapist-avatar" style="background: var(--primary-gradient);">
                                    @user.FullName.Substring(0, 1)
                                </div>
                                <span class="fw-bold text-dark">@user.FullName</span>
                            </div>
                        </td>
                        <td>
                            <span class="font-monospace text-muted small">@user.Email</span>
                        </td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: #6366f1;">
                                    <i class="bi bi-shield-check me-1"></i> @user.Role (مدير)
                                </span>
                            }
                            else if (user.Role == "Doctor")
                            {
                                <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: #0d9488;">
                                    <i class="bi bi-heart-pulse me-1"></i> @user.Role (أخصائي)
                                </span>
                            }
                            else if (user.Role == "Receptionist")
                            {
                                <span class="badge rounded-pill px-3 py-2 text-white" style="background-color: #0284c7;">
                                    <i class="bi bi-calendar-check me-1"></i> @user.Role (استقبال)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2">@user.Role</span>
                            }
                        </td>
                        <td class="small text-secondary">
                            @(user.RoleTitle ?? "-")
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(user.LinkedTherapist) && user.TherapistId.HasValue)
                            {
                                <a asp-controller="Therapists" asp-action="Edit" asp-route-id="@user.TherapistId" class="badge bg-light text-primary border text-decoration-none d-inline-flex align-items-center gap-1" title="تعديل بيانات الأخصائي">
                                    <i class="bi bi-person-badge"></i>
                                    <span>@user.LinkedTherapist</span>
                                    <i class="bi bi-pencil ms-1 text-muted" style="font-size: 0.7rem;"></i>
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(user.LinkedTherapist))
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-link-45deg me-1"></i> @user.LinkedTherapist
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @user.CreatedAt.ToString("yyyy-MM-dd")
                        </td>
                        <td class="text-start">
                            <div class="row-actions-group justify-content-end">
                                <!-- Edit Staff Account -->
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="row-action-btn row-action-edit" style="height: 32px; padding: 0 0.65rem; font-size: 0.78rem;" title="تعديل بيانات الحساب والصلاحيات">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>تعديل</span>
                                </a>

                                <!-- If Doctor / Linked Therapist, provide direct Edit Doctor Profile button -->
                                @if (user.TherapistId.HasValue)
                                {
                                    <a asp-controller="Therapists" asp-action="Edit" asp-route-id="@user.TherapistId" class="row-action-btn row-action-clinical" style="height: 32px; padding: 0 0.65rem; font-size: 0.78rem;" title="تعديل الملف الطبي للأخصائي">
                                        <i class="bi bi-person-badge"></i>
                                        <span>ملف الأخصائي</span>
                                    </a>
                                }

                                <!-- Delete Staff Account -->
                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('هل أنت متأكد من حذف حساب هذا المستخدم؟');" class="d-inline m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="row-action-btn row-action-delete" style="height: 32px; padding: 0 0.55rem;" title="حذف حساب المستخدم">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
