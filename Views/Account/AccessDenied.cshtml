@{
    ViewData["Title"] = "غير مصرح بالدخول";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-6 text-center">
        <div class="card-modern p-5">
            <div class="zone-avatar mx-auto mb-3" style="width: 80px; height: 80px; background-color: #fee2e2; color: #dc2626; font-size: 2.5rem;">
                <i class="bi bi-shield-slash-fill"></i>
            </div>
            
            <h3 class="fw-bold text-dark mb-2">عذراً، لا تمتلك الصلاحية الكافية!</h3>
            <p class="text-muted mb-4 fs-6">
                هذه الصفحة أو الإجراء مخصص لأدوار وظيفية محددة (مثل الأطباء المعالجين أو مديري النظام). دورك الوظيفي الحالي لا يتيح لك تنفيذ هذا الإجراء.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-modern btn-modern-primary">
                    <i class="bi bi-house-door me-1"></i> العودة للوحة التحكم
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-modern btn-modern-outline">
                        <i class="bi bi-box-arrow-right me-1"></i> تسجيل الخروج والتبديل
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
