@model PhysioClinic.Models.Consultation
@{
    ViewData["Title"] = "جلسة الاستشارة والتقييم السريري";
    var client = ViewBag.Client as PhysioClinic.Models.Client;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Page Title & Header -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">جلسة الفحص والاستشارة السريرية 🩺</h3>
                <p class="text-muted mb-0">توثيق نتائج فحص المدى الحركي (ROM)، القوة العضلية، والتشخيص النهائي المعتمد.</p>
            </div>
            <a asp-controller="Clients" asp-action="Index" class="btn btn-modern btn-modern-outline">
                <i class="bi bi-arrow-right me-1"></i> العودة لسجلات المرضى
            </a>
        </div>

        @if (client != null)
        {
            <div class="card-modern mb-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light">
                <div class="d-flex align-items-center gap-3">
                    <div class="therapist-avatar" style="background: var(--primary-gradient);">
                        @client.FullName.Substring(0, 1)
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">@client.FullName</h5>
                        <div class="small text-muted">@client.Phone &bull; @client.Age سنة &bull; @client.Occupation</div>
                    </div>
                </div>
                <a asp-controller="Clients" asp-action="Details" asp-route-id="@client.Id" target="_blank" class="btn btn-sm btn-modern btn-modern-soft">
                    <i class="bi bi-folder2-open me-1"></i> فتح الملف الطبي الكامل
                </a>
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

            <div class="card-modern mb-4">
                <div class="card-modern-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="zone-avatar" style="width: 36px; height: 36px; background-color: var(--primary-light); color: var(--primary-dark);">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-dark">معلومات الاستشارة الأساسية</h6>
                    </div>
                </div>
                <div class="card-modern-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ClientId" class="form-label-modern">المريض المستفيد</label>
                            <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-select form-select-modern"></select>
                            <span asp-validation-for="ClientId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TherapistId" class="form-label-modern">الأخصائي المعالج المشرف</label>
                            <select asp-for="TherapistId" asp-items="ViewBag.Therapists" class="form-select form-select-modern"></select>
                            <span asp-validation-for="TherapistId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConsultationDate" class="form-label-modern">تاريخ الاستشارة</label>
                            <input asp-for="ConsultationDate" type="date" class="form-control form-control-modern fw-bold" />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="ChiefComplaint" class="form-label-modern">الشكوى الرئيسية للمريض (Chief Complaint)</label>
                            <textarea asp-for="ChiefComplaint" rows="2" class="form-control form-control-modern" placeholder="وصف شكوى المريض وألمه الحالي بالتفصيل..."></textarea>
                            <span asp-validation-for="ChiefComplaint" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Examination & Findings -->
            <div class="card-modern mb-4">
                <div class="card-modern-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="zone-avatar" style="width: 36px; height: 36px; background-color: #ecfdf5; color: #059669;">
                            <i class="bi bi-clipboard-pulse"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-dark">الفحص السريري والتشخيص المعتمد</h6>
                    </div>
                </div>
                <div class="card-modern-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RangeOfMotionFindings" class="form-label-modern">فحص المدى الحركي (Range of Motion - ROM)</label>
                            <textarea asp-for="RangeOfMotionFindings" rows="3" class="form-control form-control-modern" placeholder="درجات ثني/بسط المفصل، التيبس، ومقارنة الجانب المصاب بالسليم..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MuscleStrengthTests" class="form-label-modern">فحص القوة العضلية والاختبارات السريرية (MMT)</label>
                            <textarea asp-for="MuscleStrengthTests" rows="3" class="form-control form-control-modern" placeholder="درجة قوة العضلات (مثال: 4/5)، اختبارات الثبات (Lachman, SLR, Neer test)..."></textarea>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Diagnosis" class="form-label-modern text-dark fs-6">التشخيص النهائي المعتمد (Clinical Diagnosis) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-teal" style="color: var(--primary);"><i class="bi bi-check2-circle"></i></span>
                                <input asp-for="Diagnosis" class="form-control form-control-modern border-start-0 fw-bold" placeholder="مثال: الانزلاق الغضروفي القطني L5-S1 أو تمزق جزئي في وتر الكتف..." />
                            </div>
                            <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TreatmentGoals" class="form-label-modern">أهداف الخطة العلاجية (Treatment Goals)</label>
                            <textarea asp-for="TreatmentGoals" rows="3" class="form-control form-control-modern" placeholder="1. تقليل الألم لأقل من 3 خلال أسبوعين&#10;2. استعادة المدى الحركي الكامل&#10;3. العودة للرياضة"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClinicalNotes" class="form-label-modern">توصيات وملاحظات عامة</label>
                            <textarea asp-for="ClinicalNotes" rows="3" class="form-control form-control-modern" placeholder="أي محاذير خاصة بالتمارين، تفادي حمل أوزان، الحاجة لدعامة..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button Bar -->
            <div class="d-flex justify-content-between align-items-center mb-5">
                <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-modern btn-modern-outline px-4">رجوع</a>
                <button type="submit" class="btn btn-modern btn-modern-primary px-5 py-3 fs-6">
                    <i class="bi bi-check-lg me-2"></i> اعتماد الاستشارة والتشخيص السريري &larr;
                </button>
            </div>
        </form>
    </div>
</div>
