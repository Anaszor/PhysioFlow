@using PhysioClinic.Models
@model IEnumerable<PhysioClinic.Models.Appointment>
@{
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
    var therapistId = ViewBag.TherapistId as int?;
    var therapists = ViewBag.Therapists as List<PhysioClinic.Models.Therapist> ?? new();
    ViewData["Title"] = "جدول المواعيد والعيادات";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            @(User.IsInRole(ClinicRoles.Doctor) ? "جدول جلساتي اليومية والسريرية 🩺" : "جدول الجلسات والمواعيد 📅")
        </h3>
        <p class="text-muted mb-0">
            @(User.IsInRole(ClinicRoles.Doctor) ? "متابعة المرضى وتوثيق الجلسات السريرية واعتماد تقارير التطور." : "إدارة تدفق المراجعين، تخطيط الفترات الزمنية، وتأكيد الحضور.")
        </p>
    </div>

    @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
    {
        <a asp-action="Book" class="btn btn-modern btn-modern-primary">
            <i class="bi bi-calendar-plus-fill me-1"></i>
            <span>حجز موعد جديد</span>
        </a>
    }
</div>

<!-- Date Navigation & Therapist Filter Bar -->
<div class="card-modern mb-4 p-3">
    <form method="get" class="row align-items-center g-3">
        <!-- Date Selector -->
        <div class="col-md-5 d-flex align-items-center gap-2">
            <a asp-action="Index" asp-route-date="@selectedDate.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-therapistId="@therapistId" class="btn btn-modern btn-modern-outline btn-sm">
                <i class="bi bi-chevron-right"></i>
            </a>

            <input type="date" name="date" class="form-control form-control-modern fw-bold text-center" value="@selectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />

            <a asp-action="Index" asp-route-date="@selectedDate.AddDays(1).ToString("yyyy-MM-dd")" asp-route-therapistId="@therapistId" class="btn btn-modern btn-modern-outline btn-sm">
                <i class="bi bi-chevron-left"></i>
            </a>

            <a asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" asp-route-therapistId="@therapistId" class="btn btn-modern btn-modern-soft btn-sm">
                اليوم
            </a>
        </div>

        <!-- Therapist Selector -->
        <div class="col-md-4">
            <select name="therapistId" class="form-select form-select-modern" onchange="this.form.submit()">
                <option value="">-- جميع الأخصائيين --</option>
                @foreach (var th in therapists)
                {
                    if (therapistId == th.Id)
                    {
                        <option value="@th.Id" selected>@th.FullName</option>
                    }
                    else
                    {
                        <option value="@th.Id">@th.FullName</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3 text-md-start text-muted small">
            <span>جلسات هذا اليوم: <strong class="text-dark fs-6">@Model.Count()</strong></span>
        </div>
    </form>
</div>

<!-- Appointments Table Card -->
<div class="card-modern">
    <div class="p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="zone-avatar mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--slate-100); color: var(--slate-400); font-size: 2rem;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">لا توجد مواعيد مجدولة في هذا التاريخ (@selectedDate.ToString("dd-MM-yyyy"))</h5>
                <p class="text-muted small">يمكنك اختيار تاريخ آخر أو التسكين في الفترات المتاحة.</p>
                @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-action="Book" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-modern btn-modern-primary mt-2">
                        <i class="bi bi-plus-lg me-1"></i> حجز موعد لهذا اليوم
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive appointments-table-container">
                <table class="table-modern table-appointments">
                    <thead>
                        <tr>
                            <th style="width: 125px;">الوقت</th>
                            <th>المريض</th>
                            <th>الأخصائي</th>
                            <th>البرنامج العلاجي</th>
                            <th>الحالة والتوثيق</th>
                            <th class="text-start" style="width: 190px;">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <div class="fw-bold text-dark font-monospace" style="font-size: 0.88rem;">
                                        <i class="bi bi-clock me-1 text-teal" style="color: var(--primary);"></i>
                                        <span dir="ltr">@appt.StartTime - @appt.EndTime</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.72rem;">جلسة 45 دقيقة</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1 text-nowrap">
                                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@appt.ClientId" class="text-decoration-none fw-bold text-dark" style="font-size: 0.88rem;" title="فتح الملف الطبي">
                                            @appt.Client?.FullName
                                        </a>
                                        @if (User.IsInRole(ClinicRoles.Admin) || User.IsInRole(ClinicRoles.Receptionist))
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0 text-muted ms-1" data-bs-toggle="modal" data-bs-target="#editPatientModal-@appt.Id" title="تعديل بيانات المريض">
                                                <i class="bi bi-pencil-square text-primary" style="font-size: 0.8rem;"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="small text-muted d-flex align-items-center gap-1 mt-0 text-nowrap" dir="ltr" style="font-size: 0.75rem;">
                                        <i class="bi bi-telephone text-muted"></i>
                                        <span>@appt.Client?.Phone</span>
                                    </div>
                                </td>
                                <td class="text-nowrap">
                                    <span class="badge rounded-pill d-inline-flex align-items-center gap-1 py-1 px-2" style="background-color: @(appt.Therapist?.ColorTag ?? "#0d9488")15; color: @(appt.Therapist?.ColorTag ?? "#0d9488"); border: 1px solid @(appt.Therapist?.ColorTag ?? "#0d9488")35; font-weight: 600; font-size: 0.8rem;" title="@appt.Therapist?.Title (@appt.Therapist?.Specialization)">
                                        <span class="rounded-circle d-inline-block" style="width: 7px; height: 7px; background-color: @(appt.Therapist?.ColorTag ?? "#0d9488");"></span>
                                        @appt.Therapist?.FullName
                                    </span>
                                </td>
                                <td>
                                    @if (appt.TreatmentPlan != null)
                                    {
                                        <a asp-controller="TreatmentPlan" asp-action="Details" asp-route-id="@appt.TreatmentPlanId" class="small text-decoration-none text-dark fw-bold d-block text-truncate" style="max-width: 155px; font-size: 0.82rem;" title="@appt.TreatmentPlan.Title">
                                            @appt.TreatmentPlan.Title
                                        </a>
                                        <div class="small text-muted" style="font-size: 0.72rem;">جلسة @appt.SessionNumber من @appt.TreatmentPlan.TotalSessions</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle" style="font-size: 0.72rem;">استشارة وتقييم</span>
                                    }
                                </td>
                                <td>
                                    <div>
                                        @if (appt.Status == "Confirmed")
                                        {
                                            <span class="badge-status badge-status-confirmed" style="font-size: 0.74rem; padding: 0.22rem 0.55rem;">حاضر بالعيادة</span>
                                        }
                                        else if (appt.Status == "Scheduled")
                                        {
                                            <span class="badge-status badge-status-scheduled" style="font-size: 0.74rem; padding: 0.22rem 0.55rem;">مجدول</span>
                                        }
                                        else if (appt.Status == "Completed")
                                        {
                                            <span class="badge-status badge-status-completed" style="font-size: 0.74rem; padding: 0.22rem 0.55rem;">مكتمل وموثق</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-status-cancelled" style="font-size: 0.74rem; padding: 0.22rem 0.55rem;">@appt.Status</span>
                                        }
                                    </div>
                                    @if (appt.Status == "Completed" && appt.PainLevelAfter.HasValue)
                                    {
                                        <div class="small fw-bold mt-1 text-nowrap" style="font-size: 0.72rem; color: var(--primary);">
                                            <i class="bi bi-heart-pulse me-1"></i> ألم بعد الجلسة: @appt.PainLevelAfter/10
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(appt.SessionNotes))
                                    {
                                        <small class="text-muted d-block text-truncate mt-1" style="max-width: 135px; font-size: 0.7rem;" title="@appt.SessionNotes">
                                            <i class="bi bi-chat-left-text me-1"></i> @appt.SessionNotes
                                        </small>
                                    }
                                </td>
                                <td class="text-start text-nowrap" style="width: 1%;">
                                    <div class="row-actions-group justify-content-end">
                                        <!-- 1. Doctor / Clinical Action -->
                                        @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                                        {
                                            @if (appt.Status != "Completed")
                                            {
                                                <button type="button" class="row-action-btn row-action-clinical" data-bs-toggle="modal" data-bs-target="#sessionModal-@appt.Id" title="توثيق الجلسة السريرية">
                                                    <i class="bi bi-file-earmark-medical"></i>
                                                    <span>توثيق</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="row-action-btn row-action-report" data-bs-toggle="modal" data-bs-target="#sessionModal-@appt.Id" title="عرض تفاصيل الجلسة والتقرير">
                                                    <i class="bi bi-check2-circle"></i>
                                                    <span>تفاصيل</span>
                                                </button>
                                                <a asp-action="SessionReport" asp-route-id="@appt.Id" target="_blank" class="row-action-btn row-action-pdf row-action-icon" title="طباعة أو تحميل تقرير الجلسة PDF">
                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                </a>
                                            }
                                        }

                                        <!-- 2. Arrival Action (وصل) -->
                                        @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                                        {
                                            @if (appt.Status == "Scheduled")
                                            {
                                                <form asp-action="ConfirmAttendance" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <button type="submit" class="row-action-btn row-action-arrival" title="تأكيد وصول المريض بالعيادة">
                                                        <i class="bi bi-person-check-fill"></i>
                                                        <span>وصل</span>
                                                    </button>
                                                </form>
                                            }

                                            <!-- 3. WhatsApp Action (Direct Icon Button) -->
                                            <form asp-action="SendReminder" method="post" class="d-inline m-0" onsubmit="return confirm('هل تريد إرسال رسالة تذكير بالموعد للمريض عبر واتساب؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appt.Id" />
                                                <button type="submit" class="row-action-btn row-action-whatsapp row-action-icon" title="إرسال تذكير واتساب للمريض">
                                                    <i class="bi bi-whatsapp"></i>
                                                </button>
                                            </form>

                                            <!-- 4. Edit Appointment Button (Direct Icon Button) -->
                                            <button type="button" class="row-action-btn row-action-edit row-action-icon" data-bs-toggle="modal" data-bs-target="#editApptModal-@appt.Id" title="تعديل الموعد والأخصائي">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <!-- 5. Cancel Button (Direct Icon Button) -->
                                            @if (appt.Status != "Cancelled")
                                            {
                                                <button type="button" class="row-action-btn row-action-cancel row-action-icon" onclick="if(confirm('هل أنت متأكد من إلغاء هذا الموعد؟')) document.getElementById('cancelForm-@appt.Id').submit();" title="إلغاء الموعد">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                        }

                                        <!-- 6. Delete Button (Admin Only, Direct Icon Button) -->
                                        @if (User.IsInRole(ClinicRoles.Admin))
                                        {
                                            <button type="button" class="row-action-btn row-action-delete row-action-icon" onclick="if(confirm('تحذير: هل أنت متأكد من حذف هذا الموعد نهائياً من قاعدة البيانات؟')) document.getElementById('deleteForm-@appt.Id').submit();" title="حذف الموعد نهائياً">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }

                                        <!-- Hidden Forms for Cancel and Delete -->
                                        <form id="cancelForm-@appt.Id" asp-action="CancelAppointment" method="post" class="d-none">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                        </form>
                                        <form id="deleteForm-@appt.Id" asp-action="Delete" method="post" class="d-none">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                        </form>
                                    </div>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- All Appointment Modals Rendered Cleanly Outside Table for Robust Mobile Layout -->
@if (Model.Any())
{
    @foreach (var appt in Model)
    {
        @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
        {
            <!-- DOCTOR & ADMIN ONLY: Post-Session Clinical Documentation Modal -->
            <div class="modal fade" id="sessionModal-@appt.Id" tabindex="-1" aria-labelledby="modalLabel-@appt.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                    <form class="modal-content border-0 shadow-lg" asp-action="CompleteSession" method="post" id="form-session-@appt.Id" style="border-radius: 1.25rem;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@appt.Id" />

                        <!-- Modal Header (Always visible and anchored at top) -->
                        <div class="modal-header border-bottom py-3 d-flex align-items-center justify-content-between" style="background-color: var(--primary-light);">
                            <div class="d-flex align-items-center gap-2">
                                <div class="zone-avatar" style="width: 38px; height: 38px; background: var(--primary); color: #fff; border-radius: 10px; flex-shrink: 0;">
                                    <i class="bi bi-clipboard2-pulse fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="modal-title fw-bold text-dark mb-0 fs-6" id="modalLabel-@appt.Id">نموذج توثيق ما بعد الجلسة (خاص بالطبيب المعالج)</h6>
                                    <small class="text-muted d-block" style="font-size: 0.78rem;">المريض: <strong>@appt.Client?.FullName</strong> | @(appt.TreatmentPlan != null ? appt.TreatmentPlan.Title : "جلسة استشارة وتقييم")</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close m-0 shadow-none" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>

                        <!-- Modal Body (Smoothly scrollable, responsive padding) -->
                        <div class="modal-body p-3 p-md-4" style="-webkit-overflow-scrolling: touch;">
                            <!-- Pain level after session -->
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">
                                    مستوى الألم بعد إتمام الجلسة (VAS Pain Scale 1-10)
                                </label>
                                <div class="d-flex align-items-center gap-3">
                                    <input type="range" class="form-range flex-grow-1" min="1" max="10" name="painLevelAfter" id="painRange-@appt.Id" value="@(appt.PainLevelAfter ?? 3)" oninput="document.getElementById('painVal-@appt.Id').innerText = this.value + ' / 10'" />
                                    <span class="badge bg-teal fs-6 px-3 py-2 rounded-pill text-white" style="background-color: var(--primary);" id="painVal-@appt.Id" dir="ltr">@(appt.PainLevelAfter ?? 3) / 10</span>
                                </div>
                                <small class="text-muted">1-3 ألم خفيف محتمل، 4-6 ألم متوسط، 7-10 ألم شديد.</small>
                            </div>

                            <!-- Modalities & Techniques -->
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">الأساليب والتقنيات المنفذة في هذه الجلسة</label>
                                <input type="text" name="techniquesUsed" class="form-control form-control-modern" value="@appt.TechniquesUsed" placeholder="مثال: علاج يدوي وتحريك فقرات قطنية، تيار TENS 15 دقيقة، إبر جافة" />
                            </div>

                            <!-- Patient Response -->
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">استجابة المريض وتحمله للتمارين (Patient Response)</label>
                                <input type="text" name="patientResponse" class="form-control form-control-modern" value="@(appt.PatientResponse ?? "")" placeholder="مثال: تحسن في المدى الحركي بنسبة 20%، خفة في الحركة دون تنميل" />
                            </div>

                            <!-- Clinical Progress Notes -->
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">الملاحظات السريرية المفصلة وتوجيهات الطبيب</label>
                                <textarea name="clinicalNotes" rows="3" class="form-control form-control-modern" placeholder="وثّق ملاحظاتك الطبية حول حالة المريض وتطورها...">@(appt.ClinicalNotes ?? appt.SessionNotes)</textarea>
                            </div>

                            <!-- Next Session Recommendations -->
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">التوصيات والتمارين المنزلية حتى الجلسة القادمة</label>
                                <input type="text" name="nextSessionPlan" class="form-control form-control-modern" value="@(appt.NextSessionPlan ?? "")" placeholder="مثال: الاستمرار على تمرين مكينزي 3 مرات يومياً والكمادات الباردة" />
                            </div>

                            <!-- Patient Signature Section -->
                            <div class="mb-2">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <label class="form-label-modern fw-bold mb-0">
                                        <i class="bi bi-pen me-1 text-primary"></i> توقيع المريض (Patient Signature)
                                    </label>
                                    <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 fw-semibold" onclick="clearSignaturePad(@appt.Id)">
                                        <i class="bi bi-eraser me-1"></i> مسح التوقيع
                                    </button>
                                </div>
                                <small class="text-muted d-block mb-2">يرجى من المريض أو ولي أمره التوقيع في المربع أدناه (باللمس أو الفأرة) لتأكيد إتمام الجلسة واستلام التوجيهات:</small>
                                
                                <div class="signature-box-wrapper position-relative rounded-3 p-2 bg-light border" style="border: 2px dashed #94a3b8 !important; min-height: 140px;">
                                    @if (!string.IsNullOrEmpty(appt.PatientSignature))
                                    {
                                        <div id="sigPreviewContainer-@appt.Id" class="text-center py-2">
                                            <img src="@appt.PatientSignature" alt="توقيع المريض" style="max-height: 100px; max-width: 100%; object-fit: contain;" />
                                            <div class="text-muted small mt-2 d-flex align-items-center justify-content-center gap-2">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-check-circle-fill me-1"></i> توقيع إلكتروني محفوظ
                                                </span>
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="enableReSign(@appt.Id)">
                                                    <i class="bi bi-arrow-repeat me-1"></i> إعادة التوقيع
                                                </button>
                                            </div>
                                        </div>
                                        <div id="sigCanvasWrapper-@appt.Id" class="d-none position-relative">
                                            <canvas id="sigCanvas-@appt.Id" class="w-100 bg-white rounded border" height="130" style="cursor: crosshair; touch-action: none;"></canvas>
                                            <div id="sigPlaceholder-@appt.Id" class="position-absolute top-50 start-50 translate-middle text-muted" style="pointer-events: none; opacity: 0.35;">
                                                <i class="bi bi-pen me-1"></i> وقع هنا (Sign Here)
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="sigCanvasWrapper-@appt.Id" class="position-relative">
                                            <canvas id="sigCanvas-@appt.Id" class="w-100 bg-white rounded border" height="130" style="cursor: crosshair; touch-action: none;"></canvas>
                                            <div id="sigPlaceholder-@appt.Id" class="position-absolute top-50 start-50 translate-middle text-muted" style="pointer-events: none; opacity: 0.35;">
                                                <i class="bi bi-pen me-1"></i> وقع هنا (Sign Here)
                                            </div>
                                        </div>
                                    }
                                    <input type="hidden" name="patientSignature" id="sigInput-@appt.Id" value="@appt.PatientSignature" />
                                </div>
                            </div>
                        </div>

                        <!-- Modal Footer (Sticky at bottom, wraps nicely on phone) -->
                        <div class="modal-footer border-top bg-light p-3 d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2">
                            <div>
                                @if (appt.Status == "Completed")
                                {
                                    <a href="@Url.Action("SessionReport", "Appointments", new { id = appt.Id })" target="_blank" class="btn btn-modern btn-outline-danger w-100 w-sm-auto">
                                        <i class="bi bi-file-earmark-pdf me-1"></i> طباعة / تحميل PDF
                                    </a>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-modern btn-modern-outline flex-grow-1 flex-sm-grow-0" data-bs-dismiss="modal">إلغاء</button>
                                <button type="submit" class="btn btn-modern btn-modern-primary flex-grow-1 flex-sm-grow-0 px-4">
                                    <i class="bi bi-check2-circle me-1"></i> اعتماد التقرير وإتمام الجلسة
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- RECEPTIONIST & ADMIN: Edit Appointment Modal -->
        @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
        {
            <div class="modal fade" id="editApptModal-@appt.Id" tabindex="-1" aria-labelledby="editApptLabel-@appt.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <form class="modal-content border-0 shadow-lg" asp-action="Edit" asp-controller="Appointments" method="post" style="border-radius: 1.25rem;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@appt.Id" />
