@using PhysioClinic.Models
@model IEnumerable<PhysioClinic.Models.Appointment>
@{
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
    var therapistId = ViewBag.TherapistId as int?;
    var therapists = ViewBag.Therapists as List<PhysioClinic.Models.Therapist> ?? new();
    var timelineSlots = ViewBag.TimelineSlots as List<PhysioClinic.Models.ViewModels.TimeslotSlot> ?? new();
    var activeClients = ViewBag.ActiveClients as List<PhysioClinic.Models.Client> ?? new();
    var activePlans = ViewBag.ActivePlans as List<PhysioClinic.Models.TreatmentPlan> ?? new();
    ViewData["Title"] = "جدول المواعيد والعيادات";
}

<!-- Page Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            @(User.IsInRole(ClinicRoles.Doctor) ? "جدول جلساتي اليومية والسريرية 🩺" : "جدول الجلسات والمواعيد 📅")
        </h3>
        <p class="text-muted mb-0">
            @(User.IsInRole(ClinicRoles.Doctor) ? "متابعة المرضى وتوثيق الجلسات السريرية واعتماد تقارير التطور." : "إدارة تدفق المراجعين، تخطيط الفترات الزمنية، وتأكيد الحضور.")
        </p>
    </div>

    @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
    {
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-modern btn-modern-primary" data-bs-toggle="modal" data-bs-target="#quickBookModal" onclick="prepareQuickBookModal('10:00')">
                <i class="bi bi-lightning-charge-fill me-1"></i>
                <span>حجز موعد سريع</span>
            </button>
            <a asp-action="Book" class="btn btn-modern btn-modern-outline">
                <i class="bi bi-calendar-plus-fill me-1"></i>
                <span class="d-none d-sm-inline">حجز مخصص (Slots)</span>
            </a>
        </div>
    }
</div>

<!-- Date Navigation & Therapist Filter Bar -->
<div class="card-modern mb-4 p-3">
    <form method="get" class="row align-items-center g-3">
        <!-- Date Selector -->
        <div class="col-md-5 d-flex align-items-center gap-2">
            <a asp-action="Index" asp-route-date="@selectedDate.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-therapistId="@therapistId" class="btn btn-modern btn-modern-outline btn-sm">
                <i class="bi bi-chevron-right"></i>
            </a>

            <input type="date" name="date" class="form-control form-control-modern fw-bold text-center" value="@selectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />

            <a asp-action="Index" asp-route-date="@selectedDate.AddDays(1).ToString("yyyy-MM-dd")" asp-route-therapistId="@therapistId" class="btn btn-modern btn-modern-outline btn-sm">
                <i class="bi bi-chevron-left"></i>
            </a>

            <a asp-action="Index" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")" asp-route-therapistId="@therapistId" class="btn btn-modern btn-modern-soft btn-sm">
                اليوم
            </a>
        </div>

        <!-- Therapist Selector -->
        <div class="col-md-4">
            <select name="therapistId" class="form-select form-select-modern" onchange="this.form.submit()">
                <option value="">-- جميع الأخصائيين --</option>
                @foreach (var th in therapists)
                {
                    if (therapistId == th.Id)
                    {
                        <option value="@th.Id" selected>@th.FullName (@th.Specialization)</option>
                    }
                    else
                    {
                        <option value="@th.Id">@th.FullName (@th.Specialization)</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3 text-md-start text-muted small">
            <span>جلسات هذا اليوم: <strong class="text-dark fs-6">@Model.Count()</strong></span>
        </div>
    </form>
</div>

<!-- Receptionist View Switcher (Table View vs Timeslots Timeline) -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <ul class="nav nav-pills p-1 bg-white border rounded-pill shadow-sm" id="viewModeTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-3 py-1 fw-semibold" id="tab-list-view" data-bs-toggle="pill" data-bs-target="#view-list" type="button">
                <i class="bi bi-list-check me-1"></i> جدول المواعيد المحجوزة (@Model.Count())
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-3 py-1 fw-semibold" id="tab-timeline-view" data-bs-toggle="pill" data-bs-target="#view-timeline" type="button">
                <i class="bi bi-grid-3x3-gap-fill me-1"></i> مخطط الفترات لليوم (Timeslots)
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1">@timelineSlots.Count(s => s.IsAvailable) فترة متاحة</span>
            </button>
        </li>
    </ul>

    @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
    {
        <div class="text-muted small">
            <i class="bi bi-info-circle me-1 text-teal" style="color: var(--primary);"></i>
            يمكنك حجز أي فترة متاحة بضغطة واحدة مباشرة من مخطط الفترات.
        </div>
    }
</div>

<div class="tab-content" id="appointmentsViewTabContent">
    <!-- TAB 1: LIST / TABLE VIEW -->
    <div class="tab-pane fade show active" id="view-list" role="tabpanel">
        <div class="card-modern">
    <div class="p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="zone-avatar mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--slate-100); color: var(--slate-400); font-size: 2rem;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">لا توجد مواعيد مجدولة في هذا التاريخ (@selectedDate.ToString("dd-MM-yyyy"))</h5>
                <p class="text-muted small">يمكنك اختيار تاريخ آخر أو التسكين في الفترات المتاحة.</p>
                @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                {
                    <a asp-action="Book" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-modern btn-modern-primary mt-2">
                        <i class="bi bi-plus-lg me-1"></i> حجز موعد لهذا اليوم
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>الوقت المخصص</th>
                            <th>المريض</th>
                            <th>الأخصائي المعالج</th>
                            <th>البرنامج العلاجي</th>
                            <th>الحالة</th>
                            <th>التقرير والملاحظات</th>
                            <th class="text-start">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark font-monospace fs-6">
                                        <i class="bi bi-clock me-1 text-teal" style="color: var(--primary);"></i>
                                        <span dir="ltr">@appt.StartTime - @appt.EndTime</span>
                                    </div>
                                    <small class="text-muted">جلسة 45 دقيقة</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@appt.ClientId" class="text-decoration-none fw-bold text-dark fs-6" title="فتح الملف الطبي">
                                            @appt.Client?.FullName
                                        </a>
                                        @if (User.IsInRole(ClinicRoles.Admin) || User.IsInRole(ClinicRoles.Receptionist))
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0 text-muted ms-1" data-bs-toggle="modal" data-bs-target="#editPatientModal-@appt.ClientId" title="تعديل بيانات المريض">
                                                <i class="bi bi-pencil-square text-primary" style="font-size: 0.85rem;"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="small text-muted d-flex align-items-center gap-2 mt-1" dir="ltr" style="text-align: right;">
                                        <a href="https://wa.me/@(appt.Client?.Phone?.Replace("+", "").Replace(" ", ""))" target="_blank" class="text-decoration-none text-success small" title="محادثة واتساب">
                                            <i class="bi bi-whatsapp"></i>
                                        </a>
                                        <span>@appt.Client?.Phone</span>
                                        <i class="bi bi-telephone text-muted"></i>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill d-inline-flex align-items-center gap-1 py-1 px-2" style="background-color: @(appt.Therapist?.ColorTag ?? "#0d9488")15; color: @(appt.Therapist?.ColorTag ?? "#0d9488"); border: 1px solid @(appt.Therapist?.ColorTag ?? "#0d9488")35; font-weight: 600; font-size: 0.82rem;">
                                        <span class="rounded-circle d-inline-block" style="width: 8px; height: 8px; background-color: @(appt.Therapist?.ColorTag ?? "#0d9488");"></span>
                                        @appt.Therapist?.FullName
                                    </span>
                                    <div class="small text-muted mt-1" style="font-size: 0.72rem;">@(appt.Therapist?.Title ?? "أخصائي معالج")</div>
                                </td>
                                <td>
                                    @if (appt.TreatmentPlan != null)
                                    {
                                        <a asp-controller="TreatmentPlan" asp-action="Details" asp-route-id="@appt.TreatmentPlanId" class="small text-decoration-none text-dark fw-bold">
                                            @appt.TreatmentPlan.Title
                                        </a>
                                        <div class="small text-muted">الجلسة #@appt.SessionNumber من أصل @appt.TreatmentPlan.TotalSessions</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">استشارة وتقييم أولي</span>
                                    }
                                </td>
                                <td>
                                    @if (appt.Status == "Confirmed")
                                    {
                                        <span class="badge-status badge-status-confirmed">حاضر بالعيادة</span>
                                    }
                                    else if (appt.Status == "Scheduled")
                                    {
                                        <span class="badge-status badge-status-scheduled">مجدول</span>
                                    }
                                    else if (appt.Status == "Completed")
                                    {
                                        <span class="badge-status badge-status-completed">مكتمل وموثق</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-cancelled">@appt.Status</span>
                                    }
                                </td>
                                <td class="small" style="max-width: 260px;">
                                    @if (appt.PainLevelAfter.HasValue)
                                    {
                                        <div class="fw-bold text-teal mb-1" style="color: var(--primary);">
                                            <i class="bi bi-heart-pulse me-1"></i> ألم بعد الجلسة: @appt.PainLevelAfter/10
                                        </div>
                                    }
                                    <span class="text-muted d-block text-truncate" title="@appt.SessionNotes">
                                        @(appt.SessionNotes ?? "لا توجد ملاحظات مسجلة بعد.")
                                    </span>
                                    @if (!string.IsNullOrEmpty(appt.CompletedByDoctorName))
                                    {
                                        <small class="text-muted d-block" style="font-size: 0.72rem;">
                                            <i class="bi bi-pen me-1"></i> د. @appt.CompletedByDoctorName
                                        </small>
                                    }
                                    @if (!string.IsNullOrEmpty(appt.PatientSignature))
                                    {
                                        <small class="text-success d-block fw-semibold mt-1" style="font-size: 0.72rem;">
                                            <i class="bi bi-pen-fill me-1"></i> توقيع المريض: موثق إلكترونياً
                                        </small>
                                    }
                                </td>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-1 justify-content-end">
                                        <!-- Primary Documentation / Report Action -->
                                        @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                                        {
                                            @if (appt.Status != "Completed")
                                            {
                                                <button type="button" class="btn btn-sm btn-modern btn-modern-primary py-1 px-2 d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#sessionModal-@appt.Id" title="توثيق الجلسة والتوقيع">
                                                    <i class="bi bi-file-earmark-medical"></i>
                                                    <span>توثيق الجلسة</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-light border py-1 px-2 text-success d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#sessionModal-@appt.Id" title="عرض وتعديل التقرير">
                                                    <i class="bi bi-check2-circle"></i>
                                                    <span>التقرير</span>
                                                </button>
                                                <a asp-action="SessionReport" asp-route-id="@appt.Id" target="_blank" class="btn btn-sm btn-outline-danger py-1 px-2 d-inline-flex align-items-center gap-1" title="طباعة أو تحميل تقرير الجلسة بصيغة PDF">
                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                    <span>PDF</span>
                                                </a>
                                            }
                                        }

                                        <!-- Receptionist & Admin Quick Actions -->
                                        @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                                        {
                                            @if (appt.Status == "Scheduled")
                                            {
                                                <form asp-action="ConfirmAttendance" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary py-1 px-2 d-inline-flex align-items-center gap-1" title="تأكيد وصول المريض بالعيادة">
                                                        <i class="bi bi-person-check-fill"></i>
                                                        <span>وصل</span>
                                                    </button>
                                                </form>

                                                <form asp-action="SendReminder" method="post" class="d-inline m-0" onsubmit="return confirm('هل تريد إرسال رسالة تذكير بالموعد للمريض عبر واتساب؟');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@appt.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" title="إرسال تذكير واتساب للمريض">
                                                        <i class="bi bi-whatsapp"></i>
                                                    </button>
                                                </form>
                                            }
                                        }

                                        <!-- Enhanced Actions Dropdown Menu -->
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-light border py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="خيارات إضافية">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" style="font-size: 0.85rem; border-radius: 0.75rem;">
                                                @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#editApptModal-@appt.Id">
                                                            <i class="bi bi-calendar2-event text-primary"></i>
                                                            <span>تعديل الموعد والأخصائي</span>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#editPatientModal-@appt.Id">
                                                            <i class="bi bi-person-gear text-info"></i>
                                                            <span>تعديل بيانات المريض</span>
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    @if (appt.Status != "Cancelled")
                                                    {
                                                        <li>
                                                            <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-warning" onclick="if(confirm('هل أنت متأكد من إلغاء هذا الموعد؟')) document.getElementById('cancelForm-@appt.Id').submit();">
                                                                <i class="bi bi-x-circle"></i>
                                                                <span>إلغاء الموعد</span>
                                                            </button>
                                                        </li>
                                                    }
                                                }
                                                @if (User.IsInRole(ClinicRoles.Admin))
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" onclick="if(confirm('تحذير: هل أنت متأكد من حذف هذا الموعد نهائياً من قاعدة البيانات؟')) document.getElementById('deleteForm-@appt.Id').submit();">
                                                            <i class="bi bi-trash"></i>
                                                            <span>حذف الموعد نهائياً</span>
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        </div>

                                        <!-- Hidden Forms for Cancel and Delete -->
                                        <form id="cancelForm-@appt.Id" asp-action="CancelAppointment" method="post" class="d-none">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                        </form>
                                        <form id="deleteForm-@appt.Id" asp-action="Delete" method="post" class="d-none">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@appt.Id" />
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- DOCTOR & ADMIN ONLY: Post-Session Clinical Documentation Modal -->
                            @if (User.IsInRole(ClinicRoles.Doctor) || User.IsInRole(ClinicRoles.Admin))
                            {
                                <div class="modal fade" id="sessionModal-@appt.Id" tabindex="-1" aria-labelledby="modalLabel-@appt.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
                                            <!-- Modal Header with Fixed X Position -->
                                            <div class="modal-header border-bottom py-3 d-flex align-items-center justify-content-between" style="background-color: var(--primary-light);">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="zone-avatar" style="width: 38px; height: 38px; background: var(--primary); color: #fff; border-radius: 10px;">
                                                        <i class="bi bi-clipboard2-pulse fs-5"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="modal-title fw-bold text-dark mb-0" id="modalLabel-@appt.Id">نموذج توثيق ما بعد الجلسة (خاص بالطبيب المعالج)</h6>
                                                        <small class="text-muted">المريض: <strong>@appt.Client?.FullName</strong> | @(appt.TreatmentPlan != null ? appt.TreatmentPlan.Title : "جلسة استشارة وتقييم")</small>
                                                    </div>
                                                </div>
                                                <button type="button" class="btn-close m-0 shadow-none" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                                            </div>

                                            <form asp-action="CompleteSession" method="post" id="form-session-@appt.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@appt.Id" />

                                                <div class="modal-body p-4" style="max-height: calc(85vh - 140px); overflow-y: auto;">
                                                    <!-- Pain level after session -->
                                                    <div class="mb-3">
                                                        <label class="form-label-modern fw-bold mb-1">
                                                            مستوى الألم بعد إتمام الجلسة (VAS Pain Scale 1-10)
                                                        </label>
                                                        <div class="d-flex align-items-center gap-3">
                                                            <input type="range" class="form-range flex-grow-1" min="1" max="10" name="painLevelAfter" id="painRange-@appt.Id" value="@(appt.PainLevelAfter ?? 3)" oninput="document.getElementById('painVal-@appt.Id').innerText = this.value + ' / 10'" />
                                                            <span class="badge bg-teal fs-6 px-3 py-2 rounded-pill text-white" style="background-color: var(--primary);" id="painVal-@appt.Id">@(appt.PainLevelAfter ?? 3) / 10</span>
                                                        </div>
                                                        <small class="text-muted">1-3 ألم خفيف محتمل، 4-6 ألم متوسط، 7-10 ألم شديد.</small>
                                                    </div>

                                                    <!-- Modalities & Techniques -->
                                                    <div class="mb-3">
                                                        <label class="form-label-modern fw-bold mb-1">الأساليب والتقنيات المنفذة في هذه الجلسة</label>
                                                        <input type="text" name="techniquesUsed" class="form-control form-control-modern" value="@appt.TechniquesUsed" placeholder="مثال: علاج يدوي وتحريك فقرات قطنية، تيار TENS 15 دقيقة، إبر جافة" />
                                                    </div>

                                                    <!-- Patient Response -->
                                                    <div class="mb-3">
                                                        <label class="form-label-modern fw-bold mb-1">استجابة المريض وتحمله للتمارين (Patient Response)</label>
                                                        <input type="text" name="patientResponse" class="form-control form-control-modern" value="@(appt.PatientResponse ?? "")" placeholder="مثال: تحسن في المدى الحركي بنسبة 20%، خفة في الحركة دون تنميل" />
                                                    </div>

                                                    <!-- Clinical Progress Notes -->
                                                    <div class="mb-3">
                                                        <label class="form-label-modern fw-bold mb-1">الملاحظات السريرية المفصلة وتوجيهات الطبيب</label>
                                                        <textarea name="clinicalNotes" rows="3" class="form-control form-control-modern" placeholder="وثّق ملاحظاتك الطبية حول حالة المريض وتطورها...">@(appt.ClinicalNotes ?? appt.SessionNotes)</textarea>
                                                    </div>

                                                    <!-- Next Session Recommendations -->
                                                    <div class="mb-3">
                                                        <label class="form-label-modern fw-bold mb-1">التوصيات والتمارين المنزلية حتى الجلسة القادمة</label>
                                                        <input type="text" name="nextSessionPlan" class="form-control form-control-modern" value="@(appt.NextSessionPlan ?? "")" placeholder="مثال: الاستمرار على تمرين مكينزي 3 مرات يومياً والكمادات الباردة" />
                                                    </div>

                                                    <!-- Patient Signature Section -->
                                                    <div class="mb-2">
                                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                                            <label class="form-label-modern fw-bold mb-0">
                                                                <i class="bi bi-pen me-1 text-primary"></i> توقيع المريض (Patient Signature)
                                                            </label>
                                                            <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 fw-semibold" onclick="clearSignaturePad(@appt.Id)">
                                                                <i class="bi bi-eraser me-1"></i> مسح التوقيع
                                                            </button>
                                                        </div>
                                                        <small class="text-muted d-block mb-2">يرجى من المريض أو ولي أمره التوقيع في المربع أدناه (باللمس أو الفأرة) لتأكيد إتمام الجلسة واستلام التوجيهات:</small>
                                                        
