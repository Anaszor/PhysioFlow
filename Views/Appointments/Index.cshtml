                            <div class="d-flex align-items-center gap-2">
                                <div class="zone-avatar" style="width: 36px; height: 36px; background: var(--primary); color: #fff; border-radius: 10px; flex-shrink: 0;">
                                    <i class="bi bi-calendar2-event fs-6"></i>
                                </div>
                                <div>
                                    <h6 class="modal-title fw-bold text-dark mb-0 fs-6" id="editApptLabel-@appt.Id">تعديل الموعد والأخصائي</h6>
                                    <small class="text-muted d-block" style="font-size: 0.78rem;">المريض: <strong>@appt.Client?.FullName</strong></small>
                                </div>
                            </div>
                            <button type="button" class="btn-close m-0 shadow-none" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>
                        <div class="modal-body p-3 p-md-4" style="-webkit-overflow-scrolling: touch;">
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">تاريخ الموعد</label>
                                <input type="date" name="appointmentDate" class="form-control form-control-modern" value="@appt.AppointmentDate.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label-modern fw-bold mb-1">وقت البدء</label>
                                    <input type="time" name="startTime" class="form-control form-control-modern" value="@appt.StartTime" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label-modern fw-bold mb-1">وقت الانتهاء</label>
                                    <input type="time" name="endTime" class="form-control form-control-modern" value="@appt.EndTime" required />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">الأخصائي المعالج</label>
                                <select name="therapistId" class="form-select form-control-modern" required>
                                    @foreach (var th in therapists)
                                    {
                                        <!option value="@th.Id" @(th.Id == appt.TherapistId ? "selected" : "")>
                                            @th.FullName
                                        </!option>
                                    }
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label-modern fw-bold mb-1">ملاحظات الموعد</label>
                                <textarea name="notes" rows="2" class="form-control form-control-modern" placeholder="أية ملاحظات إدارية أو سريرية...">@appt.SessionNotes</textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-top bg-light p-3 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-modern btn-modern-outline" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-modern btn-modern-primary">
                                <i class="bi bi-check-lg me-1"></i> حفظ تعديلات الموعد
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- RECEPTIONIST & ADMIN: Quick Edit Patient Modal -->
            <div class="modal fade" id="editPatientModal-@appt.Id" tabindex="-1" aria-labelledby="editPatientLabel-@appt.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <form class="modal-content border-0 shadow-lg" asp-action="QuickEdit" asp-controller="Clients" method="post" style="border-radius: 1.25rem;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@appt.ClientId" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <div class="modal-header border-bottom py-3 d-flex align-items-center justify-content-between" style="background-color: var(--primary-light);">
                            <div class="d-flex align-items-center gap-2">
                                <div class="zone-avatar" style="width: 36px; height: 36px; background: #0284c7; color: #fff; border-radius: 10px; flex-shrink: 0;">
                                    <i class="bi bi-person-gear fs-6"></i>
                                </div>
                                <div>
                                    <h6 class="modal-title fw-bold text-dark mb-0 fs-6" id="editPatientLabel-@appt.Id">تعديل بيانات المريض</h6>
                                    <small class="text-muted d-block" style="font-size: 0.78rem;">تحديث سريع للبيانات الشخصية والاتصال</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close m-0 shadow-none" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>
                        <div class="modal-body p-3 p-md-4" style="-webkit-overflow-scrolling: touch;">
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">اسم المريض الكامل</label>
                                <input type="text" name="fullName" class="form-control form-control-modern" value="@appt.Client?.FullName" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label-modern fw-bold mb-1">رقم الهاتف (واتساب)</label>
                                <input type="text" name="phone" dir="ltr" class="form-control form-control-modern text-end" value="@appt.Client?.Phone" required />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label-modern fw-bold mb-1">المهنة</label>
                                    <input type="text" name="occupation" class="form-control form-control-modern" value="@appt.Client?.Occupation" placeholder="مثال: مهندس" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label-modern fw-bold mb-1">رقم الهوية / الإقامة</label>
                                    <input type="text" name="nationalId" class="form-control form-control-modern" value="@appt.Client?.NationalId" />
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label-modern fw-bold mb-1">ملاحظات عامة</label>
                                <textarea name="notes" rows="2" class="form-control form-control-modern" placeholder="ملاحظات حول المريض...">@appt.Client?.Notes</textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-top bg-light p-3 d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2">
                            <a href="@Url.Action("Edit", "Clients", new { id = appt.ClientId })" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-box-arrow-up-right me-1"></i> فتح الملف الكامل
                            </a>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-modern btn-modern-outline flex-grow-1 flex-sm-grow-0" data-bs-dismiss="modal">إلغاء</button>
                                <button type="submit" class="btn btn-modern btn-modern-primary flex-grow-1 flex-sm-grow-0">
                                    <i class="bi bi-check-lg me-1"></i> حفظ البيانات
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
}


@section Scripts {
<script>
    // Digital Signature Pad Management
    const signaturePads = {};

    function initSignaturePad(apptId) {
        const canvas = document.getElementById('sigCanvas-' + apptId);
        if (!canvas) return;

        // Set internal resolution based on visible width
        const rect = canvas.getBoundingClientRect();
        if (rect.width > 0) {
            canvas.width = rect.width;
            canvas.height = 130;
        }

        const ctx = canvas.getContext('2d');
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        let isDrawing = false;
        let lastX = 0;
        let lastY = 0;
        let hasStroke = false;

        function getPos(e) {
            const r = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: clientX - r.left,
                y: clientY - r.top
            };
        }

        function startDrawing(e) {
            if (e.cancelable && e.touches) e.preventDefault();
            isDrawing = true;
            hasStroke = true;
            const pos = getPos(e);
            lastX = pos.x;
            lastY = pos.y;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);

            // Hide placeholder text on first draw
            const ph = document.getElementById('sigPlaceholder-' + apptId);
            if (ph) ph.style.display = 'none';
        }

        function draw(e) {
            if (!isDrawing) return;
            if (e.cancelable && e.touches) e.preventDefault();
            const pos = getPos(e);
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
            lastX = pos.x;
            lastY = pos.y;
        }

        function stopDrawing() {
            if (isDrawing) {
                isDrawing = false;
                const input = document.getElementById('sigInput-' + apptId);
                if (input && hasStroke) {
                    input.value = canvas.toDataURL('image/png');
                }
            }
        }

        if (!canvas.dataset.initialized) {
            canvas.addEventListener('mousedown', startDrawing);
            canvas.addEventListener('mousemove', draw);
            window.addEventListener('mouseup', stopDrawing);

            canvas.addEventListener('touchstart', startDrawing, { passive: false });
            canvas.addEventListener('touchmove', draw, { passive: false });
            window.addEventListener('touchend', stopDrawing);

            canvas.dataset.initialized = 'true';
        }

        signaturePads[apptId] = {
            canvas: canvas,
            ctx: ctx,
            clear: function() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hasStroke = false;
            }
        };
    }

    function clearSignaturePad(apptId) {
        const input = document.getElementById('sigInput-' + apptId);
        if (input) input.value = '';

        const preview = document.getElementById('sigPreviewContainer-' + apptId);
        if (preview) preview.classList.add('d-none');

        const wrapper = document.getElementById('sigCanvasWrapper-' + apptId);
        if (wrapper) wrapper.classList.remove('d-none');

        const ph = document.getElementById('sigPlaceholder-' + apptId);
        if (ph) ph.style.display = 'block';

        initSignaturePad(apptId);
        if (signaturePads[apptId]) {
            signaturePads[apptId].clear();
        }
    }

    function enableReSign(apptId) {
        clearSignaturePad(apptId);
    }

    // Modal lifecycle handling
    document.addEventListener('DOMContentLoaded', function () {
        const modals = document.querySelectorAll('[id^="sessionModal-"]');
        modals.forEach(modal => {
            modal.addEventListener('shown.bs.modal', function () {
                const apptId = this.id.replace('sessionModal-', '');
                initSignaturePad(apptId);
            });

            // Ensure canvas data is saved on form submit
            const form = modal.querySelector('form');
            if (form) {
                form.addEventListener('submit', function () {
                    const apptId = modal.id.replace('sessionModal-', '');
                    const canvas = document.getElementById('sigCanvas-' + apptId);
                    const input = document.getElementById('sigInput-' + apptId);
                    const wrapper = document.getElementById('sigCanvasWrapper-' + apptId);

                    if (canvas && input && wrapper && !wrapper.classList.contains('d-none')) {
                        const ctx = canvas.getContext('2d');
                        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
                        let drawn = false;
                        for (let i = 3; i < data.length; i += 4) {
                            if (data[i] > 0) {
                                drawn = true;
                                break;
                            }
                        }
                        if (drawn) {
                            input.value = canvas.toDataURL('image/png');
                        }
                    }
                });
            }
        });
    });
</script>
}
