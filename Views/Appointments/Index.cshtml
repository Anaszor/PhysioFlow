                                        @if (!string.IsNullOrEmpty(slot.ClientPhone))
                                        {
                                            <a href="https://wa.me/@(slot.ClientPhone.Replace("+", "").Replace(" ", ""))" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 0.75rem;" title="واتساب المريض">
                                                <i class="bi bi-whatsapp"></i>
                                            </a>
                                        }
                                        @if (slot.AppointmentId.HasValue)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border py-0 px-2 rounded-pill" style="font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#editApptModal-@slot.AppointmentId" title="تعديل الموعد">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Group 3: Evening -->
            <div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-indigo-subtle text-indigo border px-2 py-1" style="background-color: #ede9fe; color: #4338ca;"><i class="bi bi-moon-stars-fill"></i></span>
                    <h6 class="fw-bold mb-0 text-dark">الفترة المسائية (16:30 - 20:00)</h6>
                </div>
                <div class="row g-3">
                    @foreach (var slot in timelineSlots.Where(s => s.Period == "مسائي"))
                    {
                        <div class="col-md-6 col-lg-4 col-xl-3">
                            @if (slot.IsAvailable)
                            {
                                <div class="card h-100 border border-success-subtle p-3 rounded-4 shadow-sm bg-white position-relative" style="border-style: dashed !important; border-width: 2px !important;">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> متاح للحجز
                                        </span>
                                        <span class="fw-bold text-dark fs-6">
                                            <i class="bi bi-clock me-1 text-teal" style="color: var(--primary);"></i> @slot.DisplayTime
                                        </span>
                                    </div>
                                    <div class="text-muted small mb-3">
                                        جلسة علاج وتأهيل (45 دقيقة)
                                    </div>
                                    @if (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success w-100 rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center gap-1 mt-auto" onclick="prepareQuickBookModal('@slot.Time', '@slot.EndTime')" data-bs-toggle="modal" data-bs-target="#quickBookModal">
                                            <i class="bi bi-plus-circle"></i>
                                            <span>حجز هذه الفترة (@slot.Time)</span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="card h-100 border shadow-sm p-3 rounded-4 bg-white position-relative" style="border-right: 4px solid var(--primary) !important;">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        @if (slot.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success text-white px-2 py-1 rounded-pill">
                                                <i class="bi bi-person-check-fill me-1"></i> حاضر بالعيادة
                                            </span>
                                        }
                                        else if (slot.Status == "Completed")
                                        {
                                            <span class="badge bg-secondary text-white px-2 py-1 rounded-pill">
                                                <i class="bi bi-check2-all me-1"></i> مكتمل
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-calendar2-check me-1"></i> مجدول
                                            </span>
                                        }
                                        <span class="fw-bold text-dark fs-6">
                                            <i class="bi bi-clock me-1 text-primary"></i> @slot.DisplayTime
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="zone-avatar" style="width: 34px; height: 34px; background: #e0f2fe; color: #0284c7; border-radius: 8px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate small">@slot.BookedByClientName</div>
                                            <small class="text-muted d-block text-truncate" style="font-size: 0.72rem;">@slot.TherapistName</small>
                                        </div>
                                    </div>

                                    <div class="small text-muted mb-2 d-block text-truncate" style="font-size: 0.75rem;">
                                        <i class="bi bi-clipboard2-pulse me-1"></i> @slot.SessionType
                                    </div>

                                    <div class="d-flex align-items-center gap-1 justify-content-end pt-2 border-top mt-auto">
                                        @if (slot.Status == "Scheduled" && (User.IsInRole(ClinicRoles.Receptionist) || User.IsInRole(ClinicRoles.Admin)))
                                        {
                                            <form asp-action="ConfirmAttendance" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@slot.AppointmentId" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 0.75rem;" title="تأكيد وصول المريض">
                                                    <i class="bi bi-person-check-fill me-1"></i> وصل
                                                </button>
                                            </form>
                                        }
                                        @if (!string.IsNullOrEmpty(slot.ClientPhone))
                                        {
                                            <a href="https://wa.me/@(slot.ClientPhone.Replace("+", "").Replace(" ", ""))" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 0.75rem;" title="واتساب المريض">
                                                <i class="bi bi-whatsapp"></i>
                                            </a>
                                        }
                                        @if (slot.AppointmentId.HasValue)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border py-0 px-2 rounded-pill" style="font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#editApptModal-@slot.AppointmentId" title="تعديل الموعد">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
<!-- END TAB 2 -->
</div>

<!-- RECEPTIONIST & ADMIN: Quick Book Modal from Timeline Slots -->
<div class="modal fade" id="quickBookModal" tabindex="-1" aria-labelledby="quickBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.25rem; overflow: hidden;">
            <div class="modal-header border-bottom py-3 d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">
                <div class="d-flex align-items-center gap-2 text-white">
                    <div class="zone-avatar" style="width: 36px; height: 36px; background: rgba(255,255,255,0.2); color: #fff; border-radius: 10px;">
                        <i class="bi bi-lightning-charge-fill fs-6"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-white mb-0" id="quickBookModalLabel">حجز موعد سريع للفترة الزمنية</h6>
                        <small class="text-white-50">تسكين مريض مباشرة في الفترة المحددة</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white m-0 shadow-none" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <form asp-action="QuickBook" asp-controller="Appointments" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <!-- Client Selector with Instant Live Search -->
                    <div class="mb-3">
                        <label class="form-label-modern fw-bold mb-1">المريض المستفيد <span class="text-danger">*</span></label>
                        <input type="text" id="qbClientSearch" class="form-control form-control-sm mb-2" placeholder="🔍 اكتب اسم أو جوال المريض للفلترة السريعة..." oninput="filterQbClients(this.value)" autocomplete="off" />
                        <select name="clientId" id="qbClientSelect" class="form-select form-control-modern" size="4" required style="font-size: 0.88rem;">
                            @foreach (var c in activeClients)
                            {
                                <option value="@c.Id" data-name="@c.FullName" data-phone="@c.Phone">@c.FullName (@c.Phone)</option>
                            }
                        </select>
                        <small class="text-muted">اضغط على اسم المريض من القائمة أعلاه لتحديده.</small>
                    </div>

                    <!-- Therapist Selector -->
                    <div class="mb-3">
                        <label class="form-label-modern fw-bold mb-1">الأخصائي المشرف <span class="text-danger">*</span></label>
                        <select name="therapistId" id="qbTherapistSelect" class="form-select form-control-modern" required>
                            @foreach (var th in therapists)
                            {
                                <!option value="@th.Id" @(th.Id == (therapistId ?? therapists.FirstOrDefault()?.Id) ? "selected" : "")>
                                    @th.Title @th.FullName (@th.Specialization)
                                </!option>
                            }
                        </select>
                    </div>

                    <!-- Date & Timeslot -->
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <label class="form-label-modern fw-bold mb-1">تاريخ الجلسة</label>
                            <input type="date" name="appointmentDate" id="qbDateInput" class="form-control form-control-modern fw-bold" value="@selectedDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label-modern fw-bold mb-1">وقت البدء</label>
                            <input type="time" name="startTime" id="qbStartTime" class="form-control form-control-modern fw-bold" value="10:00" required onchange="calcQbEndTime(this.value)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label-modern fw-bold mb-1">وقت الانتهاء (45 د)</label>
                            <input type="time" name="endTime" id="qbEndTime" class="form-control form-control-modern" value="10:45" required />
                        </div>
                    </div>

                    <!-- Treatment Plan Selector (Optional) -->
                    <div class="mb-3">
                        <label class="form-label-modern fw-bold mb-1">البرنامج / الخطة العلاجية</label>
                        <select name="treatmentPlanId" class="form-select form-control-modern">
                            <option value="">-- جلسة استشارة وتقييم أولي --</option>
                            @foreach (var p in activePlans)
                            {
                                <option value="@p.Id">@p.Title - @p.Client?.FullName (@(p.CompletedSessions + 1)/@p.TotalSessions)</option>
                            }
                        </select>
                    </div>

                    <!-- Notes -->
                    <div class="mb-2">
                        <label class="form-label-modern fw-bold mb-1">ملاحظات إضافية</label>
                        <textarea name="notes" rows="2" class="form-control form-control-modern" placeholder="أية ملاحظات خاصة بالموعد..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light p-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-modern btn-modern-outline" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-modern btn-modern-primary px-4">
                        <i class="bi bi-calendar-check-fill me-1"></i> تأكيد حجز الموعد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Digital Signature Pad Management
    const signaturePads = {};

    function initSignaturePad(apptId) {
        const canvas = document.getElementById('sigCanvas-' + apptId);
        if (!canvas) return;

        // Set internal resolution based on visible width
        const rect = canvas.getBoundingClientRect();
        if (rect.width > 0) {
            canvas.width = rect.width;
            canvas.height = 130;
        }

        const ctx = canvas.getContext('2d');
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        let isDrawing = false;
        let lastX = 0;
        let lastY = 0;
        let hasStroke = false;

        function getPos(e) {
            const r = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: clientX - r.left,
                y: clientY - r.top
            };
        }

        function startDrawing(e) {
            if (e.cancelable && e.touches) e.preventDefault();
            isDrawing = true;
            hasStroke = true;
            const pos = getPos(e);
            lastX = pos.x;
            lastY = pos.y;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);

            // Hide placeholder text on first draw
            const ph = document.getElementById('sigPlaceholder-' + apptId);
            if (ph) ph.style.display = 'none';
        }

        function draw(e) {
            if (!isDrawing) return;
            if (e.cancelable && e.touches) e.preventDefault();
            const pos = getPos(e);
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
            lastX = pos.x;
            lastY = pos.y;
        }

        function stopDrawing() {
            if (isDrawing) {
                isDrawing = false;
                const input = document.getElementById('sigInput-' + apptId);
                if (input && hasStroke) {
                    input.value = canvas.toDataURL('image/png');
                }
            }
        }

        if (!canvas.dataset.initialized) {
            canvas.addEventListener('mousedown', startDrawing);
            canvas.addEventListener('mousemove', draw);
            window.addEventListener('mouseup', stopDrawing);

            canvas.addEventListener('touchstart', startDrawing, { passive: false });
            canvas.addEventListener('touchmove', draw, { passive: false });
            window.addEventListener('touchend', stopDrawing);

            canvas.dataset.initialized = 'true';
        }

        signaturePads[apptId] = {
            canvas: canvas,
            ctx: ctx,
            clear: function() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hasStroke = false;
            }
        };
    }

    function clearSignaturePad(apptId) {
        const input = document.getElementById('sigInput-' + apptId);
        if (input) input.value = '';

        const preview = document.getElementById('sigPreviewContainer-' + apptId);
        if (preview) preview.classList.add('d-none');

        const wrapper = document.getElementById('sigCanvasWrapper-' + apptId);
        if (wrapper) wrapper.classList.remove('d-none');

        const ph = document.getElementById('sigPlaceholder-' + apptId);
        if (ph) ph.style.display = 'block';

        initSignaturePad(apptId);
        if (signaturePads[apptId]) {
            signaturePads[apptId].clear();
        }
    }

    function enableReSign(apptId) {
        clearSignaturePad(apptId);
    }

    // Modal lifecycle handling
    document.addEventListener('DOMContentLoaded', function () {
        const modals = document.querySelectorAll('[id^="sessionModal-"]');
        modals.forEach(modal => {
            modal.addEventListener('shown.bs.modal', function () {
                const apptId = this.id.replace('sessionModal-', '');
                initSignaturePad(apptId);
            });

            // Ensure canvas data is saved on form submit
            const form = modal.querySelector('form');
            if (form) {
                form.addEventListener('submit', function () {
                    const apptId = modal.id.replace('sessionModal-', '');
                    const canvas = document.getElementById('sigCanvas-' + apptId);
                    const input = document.getElementById('sigInput-' + apptId);
                    const wrapper = document.getElementById('sigCanvasWrapper-' + apptId);

                    if (canvas && input && wrapper && !wrapper.classList.contains('d-none')) {
                        const ctx = canvas.getContext('2d');
                        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
                        let drawn = false;
                        for (let i = 3; i < data.length; i += 4) {
                            if (data[i] > 0) {
                                drawn = true;
                                break;
                            }
                        }
                        if (drawn) {
                            input.value = canvas.toDataURL('image/png');
                        }
                    }
                });
            }
        });
    });
    // Quick Booking Modal Helpers
    function prepareQuickBookModal(startTime, endTime) {
        if (startTime) {
            const startInput = document.getElementById('qbStartTime');
            if (startInput) startInput.value = startTime;

            if (endTime) {
                const endInput = document.getElementById('qbEndTime');
                if (endInput) endInput.value = endTime;
            } else {
                calcQbEndTime(startTime);
            }
        }
    }

    function calcQbEndTime(startVal) {
        if (!startVal) return;
        const parts = startVal.split(':');
        if (parts.length === 2) {
            let h = parseInt(parts[0]);
            let m = parseInt(parts[1]) + 45;
            if (m >= 60) {
                h = (h + Math.floor(m / 60)) % 24;
                m = m % 60;
            }
            const hStr = h < 10 ? '0' + h : h;
            const mStr = m < 10 ? '0' + m : m;
            const endInput = document.getElementById('qbEndTime');
            if (endInput) endInput.value = `${hStr}:${mStr}`;
        }
    }

    function filterQbClients(search) {
        const term = (search || '').toLowerCase().trim();
        const select = document.getElementById('qbClientSelect');
        if (!select) return;
        Array.from(select.options).forEach(opt => {
            const name = (opt.dataset.name || opt.text || '').toLowerCase();
            const phone = (opt.dataset.phone || '').toLowerCase();
            if (!term || name.includes(term) || phone.includes(term)) {
                opt.style.display = '';
            } else {
                opt.style.display = 'none';
            }
        });
    }
</script>
}
