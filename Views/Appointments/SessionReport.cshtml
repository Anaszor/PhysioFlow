@model PhysioClinic.Models.Appointment
@{
    Layout = null;
    var client = Model.Client;
    var therapist = Model.Therapist;
    var plan = Model.TreatmentPlan;
    var painLevel = Model.PainLevelAfter ?? 3;
    var docName = !string.IsNullOrEmpty(Model.CompletedByDoctorName) ? Model.CompletedByDoctorName : (therapist?.FullName ?? "الأخصائي المعالج");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>توثيق الجلسة - @(client?.FullName ?? "مريض") - #@Model.Id</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 RTL & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- html2pdf.js for Client-Side Direct PDF Download -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        :root {
            --primary: #0d9488;
            --primary-dark: #0f766e;
            --primary-light: #ccfbf1;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-600: #475569;
            --slate-200: #e2e8f0;
            --slate-100: #f1f5f9;
            --slate-50: #f8fafc;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'IBM Plex Sans Arabic', 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Screen Toolbar */
        .report-toolbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: #ffffff;
            border-bottom: 1px solid #cbd5e1;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
            padding: 12px 24px;
        }

        /* Full-Page Document Container (A4 Proportioned) */
        .report-sheet {
            max-width: 820px;
            margin: 20px auto 30px auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            padding: 28px 36px;
            position: relative;
            border: 1px solid #e2e8f0;
        }

        .report-header {
            border-bottom: 2px solid var(--primary);
            padding-bottom: 14px;
            margin-bottom: 14px;
        }

        .clinic-brand-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .meta-card {
            background-color: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: 10px;
            padding: 14px 18px;
        }

        .section-title {
            font-size: 0.94rem;
            font-weight: 700;
            color: var(--slate-800);
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 8px;
            padding-bottom: 5px;
            border-bottom: 1px dashed var(--slate-200);
        }

        .section-title i {
            color: var(--primary);
        }

        /* VAS Pain Scale Component */
        .vas-scale-container {
            display: flex;
            gap: 4px;
            margin-top: 8px;
        }

        .vas-step {
            flex: 1;
            text-align: center;
            padding: 7px 0;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.88rem;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #64748b;
        }

        .vas-step.active {
            color: #ffffff !important;
            transform: scale(1.05);
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
            border-color: transparent !important;
        }

        .vas-green { background: #dcfce7; color: #166534; }
        .vas-green.active { background: #16a34a !important; }

        .vas-yellow { background: #fef9c3; color: #854d0e; }
        .vas-yellow.active { background: #ca8a04 !important; }

        .vas-orange { background: #ffedd5; color: #9a3412; }
        .vas-orange.active { background: #ea580c !important; }

        .vas-red { background: #fee2e2; color: #991b1b; }
        .vas-red.active { background: #dc2626 !important; }

        /* Signatures Box */
        .signature-box {
            border: 1px solid var(--slate-200);
            border-radius: 10px;
            padding: 14px 18px;
            background: #ffffff;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .signature-display-area {
            min-height: 72px;
            max-height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-bottom: 1px dashed #cbd5e1;
            margin: 6px 0;
            padding: 3px 0;
        }

        /* Perfect Full-Page Single A4 Print Media Styles */
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 7mm 10mm;
            }

            html, body {
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                height: 100% !important;
            }

            .report-toolbar, .no-print {
                display: none !important;
            }

            .report-sheet {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                page-break-inside: avoid !important;
                page-break-after: avoid !important;
            }

            .row, .meta-card, .signature-box {
                page-break-inside: avoid !important;
            }
        }
    </style>
</head>
<body>

    <!-- Screen Toolbar (Hidden When Printing) -->
    <div class="report-toolbar no-print">
        <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between gap-3" style="max-width: 860px;">
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Index", "Appointments", new { date = Model.AppointmentDate.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary btn-sm py-1">
                    <i class="bi bi-arrow-right me-1"></i> العودة للمواعيد
                </a>
                <span class="text-muted">|</span>
                <span class="fw-bold text-dark">تقرير توثيق الجلسة - #@Model.Id</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary btn-sm px-3 fw-bold" onclick="window.print()">
                    <i class="bi bi-printer-fill me-1"></i> طباعة فورية (Print)
                </button>
                <button type="button" class="btn btn-danger btn-sm px-3 fw-bold" id="btnDownloadPdf" onclick="downloadAsPdf()">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> تحميل كـ PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Official Printable Report Sheet (Fills the Page Gracefully) -->
    <div class="report-sheet" id="reportContent">
        <!-- 1. Clinic Official Header -->
        <div class="report-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="clinic-brand-icon">
                    <i class="bi bi-activity"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Physio<span style="color: var(--primary);">Flow</span> Clinic</h4>
                    <div class="text-muted fw-semibold" style="font-size: 0.88rem;">مركز فيزيو فلو للعلاج الطبيعي والتأهيل السريري المتقدم</div>
                    <div class="text-muted" style="font-size: 0.78rem;">ترخيص وزارة الصحة: MED-JOR-84920 | هاتف: +962 7 9123 4567</div>
                </div>
            </div>

            <div class="text-start">
                <span class="badge bg-teal px-3 py-2 text-white fw-bold mb-1" style="background-color: var(--primary); font-size: 0.85rem;">
                    تقرير توثيق جلسة سريرية
                </span>
                <div class="text-muted small">المستند: <strong class="text-dark font-monospace">#SESS-@Model.Id.ToString("D5")</strong></div>
                <div class="text-muted small">تاريخ التوثيق: <strong class="text-dark">@DateTime.Now.ToString("yyyy/MM/dd")</strong></div>
            </div>
        </div>

        <!-- 2. Patient & Session Information Cards -->
        <div class="row g-3 mb-3">
            <!-- Patient Info -->
            <div class="col-6">
                <div class="meta-card h-100">
                    <div class="fw-bold text-dark mb-2 border-bottom pb-1" style="font-size: 0.95rem;">
                        <i class="bi bi-person-fill text-primary me-1"></i> بيانات المريض
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">الاسم الكامل:</span>
                        <strong class="text-dark">@(client?.FullName ?? "غير محدد")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">رقم الملف:</span>
                        <span class="font-monospace text-dark">PF-C-@(client?.Id.ToString("D4") ?? "-")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">رقم الجوال:</span>
                        <span dir="ltr" class="text-dark">@(client?.Phone ?? "-")</span>
                    </div>
                    <div class="d-flex justify-content-between" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">العمر / الجنس:</span>
                        <span class="text-dark">@(client != null ? $"{client.Age} سنة" : "-") / @(client?.Gender == "Male" ? "ذكر" : "أنثى")</span>
                    </div>
                </div>
            </div>

            <!-- Session & Appointment Details -->
            <div class="col-6">
                <div class="meta-card h-100">
                    <div class="fw-bold text-dark mb-2 border-bottom pb-1" style="font-size: 0.95rem;">
                        <i class="bi bi-calendar2-check-fill text-primary me-1"></i> تفاصيل الجلسة والموعد
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">الأخصائي المعالج:</span>
                        <strong class="text-dark">د. @docName</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">تاريخ الجلسة:</span>
                        <strong class="text-dark">@Model.AppointmentDate.ToString("yyyy/MM/dd")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">الوقت المخصص:</span>
                        <span dir="ltr" class="font-monospace text-dark">@Model.StartTime - @Model.EndTime</span>
                    </div>
                    <div class="d-flex justify-content-between" style="font-size: 0.88rem; line-height: 1.5;">
                        <span class="text-muted">البرنامج العلاجي:</span>
                        <span class="text-dark fw-semibold">
                            @(plan != null ? $"{plan.Title} (جلسة #{Model.SessionNumber})" : "جلسة استشارة وتقييم")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Visual VAS Pain Scale Evaluation -->
        <div class="meta-card mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="fw-bold text-dark" style="font-size: 0.95rem;">
                    <i class="bi bi-heart-pulse-fill text-danger me-1"></i>
                    مستوى الألم بعد إتمام الجلسة (VAS Pain Scale 1-10)
                </div>
                <div>
                    @if (painLevel <= 3)
                    {
                        <span class="badge bg-success px-3 py-1 fs-6">الدرجة: @painLevel / 10 - ألم خفيف محتمل (Mild)</span>
                    }
                    else if (painLevel <= 6)
                    {
                        <span class="badge bg-warning text-dark px-3 py-1 fs-6">الدرجة: @painLevel / 10 - ألم متوسط (Moderate)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-1 fs-6">الدرجة: @painLevel / 10 - ألم شديد (Severe)</span>
                    }
                </div>
            </div>

            <div class="vas-scale-container">
                @for (int i = 1; i <= 10; i++)
                {
                    string colorClass = i <= 3 ? "vas-green" : (i <= 6 ? "vas-yellow" : (i <= 8 ? "vas-orange" : "vas-red"));
                    string activeClass = i == painLevel ? "active" : "";
                    <div class="vas-step @colorClass @activeClass">
                        <div>@i</div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-between text-muted small mt-1" style="font-size: 0.78rem;">
                <span>1 - 3 ألم خفيف ومريح</span>
                <span>4 - 6 ألم متوسط ومحتمل</span>
                <span>7 - 10 ألم شديد يتطلب راحة</span>
            </div>
        </div>

        <!-- 4. Clinical Findings & Progress (2x2 Grid with generous space) -->
        <div class="row g-3 mb-3">
            <!-- Modalities & Techniques -->
            <div class="col-6">
                <div class="meta-card h-100" style="min-height: 110px;">
                    <div class="section-title">
                        <i class="bi bi-tools"></i> الأساليب والتقنيات العلاجية المنفذة
                    </div>
                    <p class="mb-0 text-dark fw-semibold" style="font-size: 0.88rem; line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.TechniquesUsed) ? "علاج طبيعي وتأهيل حركي قياسي وفق الخطة المعتمدة." : Model.TechniquesUsed)
                    </p>
                </div>
            </div>

            <!-- Patient Response & Tolerance -->
            <div class="col-6">
                <div class="meta-card h-100" style="min-height: 110px;">
                    <div class="section-title">
                        <i class="bi bi-activity"></i> استجابة المريض وتحمله (Patient Response)
                    </div>
                    <p class="mb-0 text-dark" style="font-size: 0.88rem; line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.PatientResponse) ? "استجابة ممتازة واستقرار ملحوظ في الأداء الحركي دون أي مضاعفات." : Model.PatientResponse)
                    </p>
                </div>
            </div>

            <!-- Clinical Detailed Notes -->
            <div class="col-6">
                <div class="meta-card h-100" style="min-height: 110px;">
                    <div class="section-title">
                        <i class="bi bi-clipboard2-pulse"></i> الملاحظات السريرية المفصلة وتوجيهات الطبيب
                    </div>
                    <p class="mb-0 text-dark" style="font-size: 0.88rem; line-height: 1.6; white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.ClinicalNotes) ? (string.IsNullOrWhiteSpace(Model.SessionNotes) ? "تمت متابعة الحالة وفق البروتوكول السريري المعتمد بدون ملاحظات استثنائية." : Model.SessionNotes) : Model.ClinicalNotes)
                    </p>
                </div>
            </div>

            <!-- Home Recommendations & Next Session Plan -->
            <div class="col-6">
                <div class="meta-card h-100" style="min-height: 110px;">
                    <div class="section-title">
                        <i class="bi bi-house-check"></i> التوصيات والبرنامج المنزلي حتى الجلسة القادمة
                    </div>
                    <p class="mb-0 text-dark" style="font-size: 0.88rem; line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.NextSessionPlan) ? "الالتزام بالتمارين المنزلية الموجهة مع الكمادات الموصى بها." : Model.NextSessionPlan)
                    </p>
                </div>
            </div>
        </div>

        <!-- 5. Official Signatures & Verification Section -->
        <div class="row g-3 mb-2">
            <!-- Doctor / Specialist Endorsement -->
            <div class="col-6">
                <div class="signature-box" style="min-height: 150px;">
                    <div>
                        <div class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">
                            <i class="bi bi-patch-check-fill text-primary me-1"></i> اعتماد الأخصائي المعالج
                        </div>
                        <div class="text-muted small">أشهد بتقديم الجلسة وتوثيق الحالة بدقة سريرية.</div>
                    </div>

                    <div class="signature-display-area text-center my-1">
                        <div class="border rounded-pill px-4 py-2 bg-light text-primary fw-bold font-monospace shadow-sm d-inline-block" style="font-size: 0.92rem;">
                            <i class="bi bi-award me-1"></i> د. @docName
                        </div>
                    </div>

                    <div class="text-muted small d-flex justify-content-between pt-1 border-top" style="font-size: 0.80rem;">
                        <span>الصفة: @(therapist?.Title ?? "أخصائي علاج طبيعي")</span>
                        <span>التاريخ: @Model.AppointmentDate.ToString("yyyy/MM/dd")</span>
                    </div>
                </div>
            </div>

            <!-- Patient Signature -->
            <div class="col-6">
                <div class="signature-box" style="min-height: 150px;">
                    <div>
                        <div class="fw-bold text-dark mb-1" style="font-size: 0.95rem;">
                            <i class="bi bi-pen-fill text-primary me-1"></i> توقيع المريض (Patient Signature)
                        </div>
                        <div class="text-muted small">إقرار استلام الجلسة وفهم التعليمات والتوصيات المنزلية.</div>
                    </div>

                    <div class="signature-display-area my-1">
                        @if (!string.IsNullOrEmpty(Model.PatientSignature))
                        {
                            <img src="@Model.PatientSignature" alt="توقيع المريض" style="max-height: 70px; max-width: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-center text-muted" style="border-bottom: 2px solid #cbd5e1; width: 75%; padding-bottom: 4px;">
                                <small>توقيع المريض / ولي الأمر</small>
                            </div>
                        }
                    </div>

                    <div class="text-muted small d-flex justify-content-between pt-1 border-top" style="font-size: 0.80rem;">
                        <span>المريض: <strong>@(client?.FullName ?? "المراجع")</strong></span>
                        <span>التاريخ: @Model.AppointmentDate.ToString("yyyy/MM/dd")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Footer Notice -->
        <div class="text-center text-muted pt-2 border-top" style="font-size: 0.74rem; line-height: 1.5;">
            <div>هذا التقرير صادر إلكترونياً وموثق ومعتمد في السجل الطبي لمركز فيزيو فلو (PhysioFlow EMR System).</div>
            <div>رمز التحقق الأمني: <span class="font-monospace fw-bold">PF-SEC-@Model.Id-@Model.AppointmentDate.ToString("yyyyMMdd")</span> | رقم الصفحة: 1 من 1</div>
        </div>
    </div>

    <!-- Client-side PDF Generation Script -->
    <script>
        function downloadAsPdf() {
            const btn = document.getElementById('btnDownloadPdf');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري التحميل...';
            btn.disabled = true;

            const element = document.getElementById('reportContent');
            const patientName = '@(client?.FullName?.Replace(" ", "_") ?? "Patient")';
            const sessionDate = '@Model.AppointmentDate.ToString("yyyyMMdd")';
            const filename = `Session-Report-${patientName}-${sessionDate}.pdf`;

            const opt = {
                margin:       [8, 10, 8, 10],
                filename:     filename,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, logging: false },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }).catch(err => {
                console.error('PDF generation error:', err);
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                window.print();
            });
        }
    </script>
</body>
</html>
